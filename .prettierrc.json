{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "proseWrap": "preserve",
  "overrides": [
    {
      "files": "*.md",
      "options": {
        "proseWrap": "preserve",
        "printWidth": 100
      }
    },
    {
      "files": "*.toml",
      "options": {
        "plugins": ["prettier-plugin-toml"]
      }
    },
    {
      "files": ["*.sh", "*.bash"],
      "options": {
        "plugins": ["prettier-plugin-sh"],
        "tabWidth": 2,
        "useTabs": false
      }
    }
  ]
}
