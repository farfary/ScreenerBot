## Glossary (Persian)
# Persian has no grammatical gender; none is recorded.
# Position = پوزیشن
# Open position = پوزیشن باز
# Close / closed position = بستن پوزیشن / پوزیشن بسته
# Entry = ورود
# Exit = خروج
# Partial exit = خروج جزئی
# Take profit = حد سود
# Stop loss = حد ضرر
# Trailing stop = حد ضرر متحرک
# DCA (dollar-cost averaging) = DCA (میانگین‌گیری قیمت)
# Slippage = اسلیپیج
# Priority fee = کارمزد اولویت
# Pool = استخر
# Liquidity = نقدینگی
# Market cap = ارزش بازار
# Volume = حجم
# Holder = هولدر
# Token = توکن
# Mint address = آدرس مینت
# Wallet = کیف پول
# Main wallet = کیف پول اصلی
# Swap = سواپ
# Buy = خرید
# Sell = فروش
# Filter = فیلتر
# Filtering = فیلترینگ
# Strategy = استراتژی
# Condition = شرط
# Signal = سیگنال
# Paper trading = معاملات آزمایشی
# Copy trading = کپی‌تریدینگ
# Copy task = وظیفه کپی
# Watchlist = فهرست پایش
# Blacklist = فهرست سیاه
# Whitelist = فهرست سفید
# Profit and loss (P&L) = سود و زیان
# Unrealized = تحقق‌نیافته
# Realized = تحقق‌یافته
# Balance = موجودی
# Dashboard = داشبورد
# Settings = تنظیمات
# Trader (the automated trading engine) = معامله‌گر خودکار (short: معامله‌گر)
# Force stop = توقف اجباری
# Loss limit = محدودیت ضرر
# Candle = کندل
# Chart = نمودار
# Transaction = تراکنش
# Signature = امضا
# Rug pull = راگ‌پول
# Security score = امتیاز امنیتی
# Airdrop = ایردراپ
# Assistant (the AI assistant) = دستیار
# Provider (LLM or RPC provider) = ارائه‌دهنده
# Endpoint = اندپوینت
# Scheduled task = وظیفه زمان‌بندی‌شده
# Notification = اعلان
# Explore Mode = حالت کاوش
# Backfill = پرکردن داده‌های گذشته
# Holding (tokens held) = دارایی
# Round (copy round) = دور
# Arm live = فعال‌سازی زنده
# Kill switch = کلید توقف اضطراری
# Authority (mint/freeze) = اختیار (مینت/فریز)
# Sub-wallet = کیف پول فرعی
# Secondary wallet = کیف پول ثانویه
# Instruction (assistant) = دستورالعمل
# Instruction (on-chain) = اینستراکشن
# Model (LLM) = مدل
# Confidence = اطمینان
# Latency = تأخیر
# Boost / boosted = بوست / بوست‌شده
# Featured = ویژه
# Rent (token account) = رنت
# Burn = برن
# Reclaim = بازپس‌گیری
# Passed / rejected (filter) = تأییدشده / ردشده
# Average (short) = میانگین
# Add (DCA add to a position) = افزودن
# Cooldown = زمان انتظار
# Core (backend binary) = هسته
# System tray = سینی سیستم
# Win rate = نرخ برد
# Time unit abbreviations = روز / ساعت / دقیقه / ثانیه
# Snapshot = اسنپ‌شات
# Gap (candle gap) = شکاف
# Breakout = شکست قیمت
# Wick = سایه
# Payload = محتوا
# Severity = شدت
# Cost basis = قیمت تمام‌شده
# Log = لاگ
# Watch (wallet watch) = پایش
# Preview = پیش‌نمایش
# Multi-buy / multi-sell = خرید چندگانه / فروش چندگانه
# Vanity address = آدرس اختصاصی
# Keypair = جفت‌کلید
# Honeypot = هانی‌پات
# Trade (noun) = معامله
# Router = روتر
# Quote (swap quote) = قیمت پیشنهادی
# Base / Quote (pool token roles) = پایه / مظنه
# Dust (worthless leftover balances) = داست
# Poll (noun) = بررسی دوره‌ای (never نظرسنجی, which means a survey)
# Uptime = مدت فعالیت
# Insiders = اینسایدرها
# Whale = نهنگ
# Emergency stop = توقف اضطراری
# Profit factor = ضریب سود
# Drawdown = افت سرمایه
# Hold time = مدت نگهداری
# Timeframe = بازه زمانی
# Moving average = میانگین متحرک
# Compute units = واحد محاسباتی
# Lookback = بازه بازبینی
# Explorer (block explorer) = اکسپلورر
# Consolidation = تجمیع
# Top up = شارژ
# Trade Watcher = ناظر معاملات
# Holder Watch = پایش هولدرها
# Prompt (LLM) = پرامپت
# Amount = مقدار
# Deployer = دیپلویر
# ON / OFF = فعال / غیرفعال
