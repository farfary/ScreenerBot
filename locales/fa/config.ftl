config-events-record-ohlcv = ثبت رویدادهای OHLCV
    .hint = ثبت رویدادهای پایش OHLCV (کشف، دریافت، شکاف‌ها، پرکردن داده‌های گذشته)
config-events-record-pool = ثبت رویدادهای استخر
