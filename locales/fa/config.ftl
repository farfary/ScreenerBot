## account

config-account-auto-wallet-signin = ورود خودکار با کیف پول من
    .hint = وقتی این کیف پول از قبل حساب { -brand } دارد، هنگام راه‌اندازی بدون پرسش وارد شوید. به‌طور پیش‌فرض خاموش است: امضای یک پیام با کلید معاملاتی شما باید انتخاب خودتان باشد، نه تصمیم ربات.
config-account-refresh-margin-secs = حاشیه تمدید توکن (ثانیه)
    .hint = تمدید توکن ورود چه مدت پیش از انقضا انجام شود. فقط هنگام اشکال‌زدایی احراز هویت آن را تغییر دهید.
config-account-use-gateway-rpc = استفاده از RPC { -brand } برای ارسال تراکنش‌ها
    .hint = تراکنش‌های سواپ امضاشده از طریق screenerbot.io پخش می‌شوند، نه RPC خودتان. امضا همیشه روی همین دستگاه انجام می‌شود و سرور نمی‌تواند تراکنش امضاشده را تغییر دهد. برای داده قیمت همچنان به RPC خودتان نیاز است.

## agent_control

config-agent-control-analysis = ابزارهای تحلیل
    .hint = سطح دسترسی ابزارهای تحلیل (allow، ask_user، deny)
    .placeholder = allow
config-agent-control-config = ابزارهای پیکربندی
    .hint = سطح دسترسی ابزارهای پیکربندی (allow، ask_user، deny). همه تنظیمات برنامه، از جمله اندپوینت‌های RPC، در دسترس است؛ کلید خصوصی کیف پول در هیچ سطحی برای عامل قابل خواندن یا نوشتن نیست
    .placeholder = allow
config-agent-control-enabled = فعال‌سازی کنترل عامل
    .hint = پل عامل loopback احراز هویت‌شده و آداپتور MCP با stdio را فعال می‌کند. کلاینت‌های جفت‌نشده هیچ ابزاری دریافت نمی‌کنند
config-agent-control-portfolio = ابزارهای پورتفوی
    .hint = سطح دسترسی ابزارهای پورتفوی (allow، ask_user، deny)
    .placeholder = allow
config-agent-control-system = ابزارهای سیستم
    .hint = سطح دسترسی ابزارهای سیستم (allow، ask_user، deny)
    .placeholder = allow
config-agent-control-trading = ابزارهای معاملاتی
    .hint = سطح دسترسی ابزارهای معاملاتی (allow، ask_user، deny) برای دستیار داخل برنامه و اتوماسیون زمان‌بندی‌شده. اتصال‌های عامل جفت‌شده سیاست مخصوص خود را دارند که برای هر اتصال در تنظیمات ← اتصال‌های عامل تعیین می‌شود
    .placeholder = allow

## assistant

config-assistant-auto-summarize = خلاصه‌سازی خودکار
    .hint = مکالمه‌های طولانی برای صرفه‌جویی در بافت، به‌طور خودکار خلاصه و فشرده می‌شوند
config-assistant-check-interval-seconds = فاصله بررسی
    .hint = زمان‌بند هر چند وقت یک‌بار وظایف آماده اجرا را بررسی می‌کند
    .unit = ثانیه
config-assistant-default-timeout-seconds = مهلت پیش‌فرض
    .hint = بیشینه زمانی که یک وظیفه زمان‌بندی‌شده پیش از توقف می‌تواند اجرا شود
    .unit = ثانیه
config-assistant-enabled = فعال‌سازی دستیار
    .hint = رابط گفتگوی دستیار را برای مکالمه‌های تعاملی فعال می‌کند
config-assistant-event-triggers-enabled = محرک‌های رویداد
    .hint = به دستیار اجازه می‌دهد بر اساس رویدادها اقدام‌ها را فعال کند (برای ایمنی به‌طور پیش‌فرض غیرفعال است)
config-assistant-max-concurrent = بیشینه وظایف همزمان
    .hint = بیشینه تعداد وظایف زمان‌بندی‌شده‌ای که می‌توانند همزمان اجرا شوند
config-assistant-max-session-messages = بیشینه پیام‌های نشست
    .hint = بیشینه پیام‌ها در هر نشست گفتگو پیش از خلاصه‌سازی خودکار
    .unit = پیام
config-assistant-scheduled-tasks-enabled = وظایف زمان‌بندی‌شده
    .hint = وظایف خودکار دستیار را که طبق زمان‌بندی اجرا می‌شوند فعال می‌کند

## copy_trading

config-copy-trading-default-slippage-pct = اسلیپیج پیش‌فرض
    .hint = اسلیپیج پیش‌فرض کپی آزمایشی و کپی زنده در آینده
    .unit = %
config-copy-trading-enabled = کپی کیف پول
    .hint = پردازش وظایف کپی را فعال می‌کند
config-copy-trading-latency-kill-switch-enabled = توقف اضطراری بر اساس تأخیر
    .hint = وقتی تأخیر اخیر از هدف تا تشخیص بالاتر از حد تنظیم‌شده بماند، وظیفه کپی متوقف می‌شود
config-copy-trading-latency-window-size = پنجره نمونه تأخیر
    .hint = تعداد مشاهدات اخیر که توقف اضطراری بر اساس تأخیر از آن‌ها استفاده می‌کند
config-copy-trading-max-active-tasks = بیشینه وظایف فعال
    .hint = بیشینه وظایف کپی که همزمان فعال‌اند؛ وظایف آزمایشی و زنده هر دو حساب می‌شوند، چون هر کدام کیف پول خود را پایش می‌کند
config-copy-trading-max-arrival-distance-ms = بیشینه تأخیر رسیدن
    .hint = وقتی میانگین تأخیر از هدف تا تشخیص در پنجره نمونه اخیر از این مقدار بیشتر شود، متوقف می‌شود
    .unit = ms
config-copy-trading-readiness-min-closed-rounds = دورهای آمادگی زنده
    .hint = تعداد دورهای آزمایشی بسته که یک وظیفه پیش از قبولی چک‌لیست آمادگی زنده به آن‌ها نیاز دارد
config-copy-trading-require-filter-pass = الزام عبور از فیلتر
    .hint = فقط توکن‌های پذیرفته‌شده توسط خط لوله فیلترینگ کپی می‌شوند

## events

config-events-enabled = فعال‌سازی سیستم رویدادها
    .hint = هشدار: رویدادها می‌توانند روزانه بیش از 5 گیگابایت داده تولید کنند. فقط برای اشکال‌زدایی/توسعه فعال کنید.
config-events-record-api = ثبت رویدادهای API
