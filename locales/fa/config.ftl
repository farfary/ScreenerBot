config-events-record-system = ثبت رویدادهای سیستم
    .hint = ثبت رویدادهای چرخه حیات سیستم (راه‌اندازی، توقف، خطاها)
config-events-record-token = ثبت رویدادهای توکن
    .hint = ثبت رویدادهای مرتبط با توکن (فهرست سیاه، فراداده، اعشار)
config-events-record-trader = ثبت رویدادهای معامله‌گر
    .hint = ثبت رویدادهای هماهنگی معامله‌گر (چرخه حیات، تصمیم‌گیری)
config-events-record-transaction = ثبت رویدادهای تراکنش
    .hint = ثبت رویدادهای تراکنش بلاکچین (ارسال، دریافت، تأیید)
config-events-record-wallet = ثبت رویدادهای کیف پول
    .hint = ثبت رویدادهای کیف پول (تغییر موجودی، مدیریت ATA)

