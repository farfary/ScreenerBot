errors-trade-no-tokens-in-wallet = Für diese Position wurden keine Tokens in der Wallet gefunden. Der Token-Bestand ist 0; die Position kann nicht per Swap geschlossen werden.
errors-trade-percentage-range = percentage muss in (0, 100] liegen
errors-trade-amount-tokens-invalid = amount_tokens muss positiv sein
errors-trade-sell-amount-zero = Die berechnete Verkaufsmenge ist null

errors-trade-quote-registry-unavailable = Swap-Routing ist noch nicht bereit
    .hint = Der Swap-Dienst startet noch. Warten Sie, bis die Dienste bereit sind, und versuchen Sie es dann erneut.
errors-trade-quote-no-routers-enabled = Keine Swap-Anbieter aktiviert
    .hint = Aktivieren Sie mindestens einen Swap-Router in den Trader-Einstellungen und versuchen Sie es erneut.
errors-trade-quote-not-tradable = Dieser Token ist derzeit nicht handelbar
    .hint = Es ist keine Liquidität oder Swap-Route verfügbar. Der Token ist möglicherweise nicht gestartet, aufgegeben oder hat keinen Pool. Versuchen Sie es später erneut oder wählen Sie einen anderen Token.
errors-trade-quote-no-route = Keine Swap-Route verfügbar
    .hint = Kein Anbieter konnte diesen Trade mit dem gewünschten Betrag routen. Versuchen Sie einen kleineren Betrag oder es gleich noch einmal.
errors-trade-quote-rate-limited = Die Swap-Anbieter begrenzen unsere Anfragen
    .hint = Die Swap-Anbieter drosseln Anfragen. Warten Sie einige Sekunden und versuchen Sie es erneut.
errors-trade-quote-timeout = Zeitüberschreitung bei der Kursanfrage
    .hint = Die Swap-Anbieter haben nicht rechtzeitig geantwortet. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut.
errors-trade-quote-router-rejected = Die Kursanfrage wurde abgelehnt
    .hint = Ein Anbieter hat einen Kurs geliefert, der unsere Sicherheitsprüfungen nicht bestanden hat und verworfen wurde. Versuchen Sie es erneut, um einen neuen abzurufen.
errors-trade-quote-not-offered-exact-out = Kein aktivierter Swap-Router liefert Kurse für eine exakte Ausgabemenge
    .hint = Die aktivierten Swap-Router berechnen einen Trade nur ausgehend vom eingesetzten Betrag. Geben Sie den einzusetzenden Betrag ein oder aktivieren Sie einen weiteren Swap-Router.
errors-trade-quote-not-offered-unsupported-venue = Kein aktivierter Swap-Router handelt im Pool dieses Tokens
    .hint = Der Token wird an einer Börse gehandelt, die die aktivierten Swap-Router noch nicht unterstützen. Aktivieren Sie einen weiteren Swap-Router und versuchen Sie es erneut.
errors-trade-quote-unavailable = Kurs konnte nicht abgerufen werden
    .hint = Die Swap-Anbieter konnten für diesen Trade keinen Kurs liefern. Versuchen Sie es gleich noch einmal.

errors-positions-not-found = Position nicht gefunden
errors-positions-already-closed = Die Position ist bereits geschlossen
errors-positions-force-close-failed = Position konnte nicht zwangsgeschlossen werden
errors-positions-already-archived = Die Position ist bereits archiviert
errors-positions-not-archived = Die Position ist nicht archiviert
errors-positions-archive-failed = Position konnte nicht archiviert werden
errors-positions-unarchive-failed = Position konnte nicht aus dem Archiv geholt werden
errors-positions-management-invalid = Copy-eigene Verwaltung erfordert eine Position mit Copy-Ursprung
errors-positions-management-failed = Positionsverwaltung konnte nicht aktualisiert werden
errors-positions-delete-failed = Position konnte nicht gelöscht werden
errors-positions-bulk-delete-failed = Archivierte Positionen konnten nicht gelöscht werden
errors-positions-detail-failed = Positionsdetails konnten nicht geladen werden
errors-positions-resolve-failed = Position konnte nicht aufgelöst werden
errors-positions-wrapped-sol-activity = Wrapped SOL hat keine Token-Aktivität

errors-tokens-database-unavailable = Token-Datenbank nicht verfügbar
errors-tokens-blacklist-failed = Token konnte nicht auf die Blacklist gesetzt werden
errors-tokens-blacklist-internal = Interner Fehler beim Blacklist-Vorgang
errors-tokens-unblacklist-failed = Token konnte nicht von der Blacklist entfernt werden
errors-tokens-unblacklist-internal = Interner Fehler beim Entfernen von der Blacklist
errors-tokens-blacklist-status-failed = Blacklist-Status konnte nicht geprüft werden
errors-tokens-blacklist-status-internal = Interner Fehler bei der Prüfung des Blacklist-Status
errors-tokens-favorites-fetch-failed = Favoriten konnten nicht abgerufen werden
errors-tokens-favorite-add-failed = Favorit konnte nicht hinzugefügt werden
errors-tokens-favorite-remove-failed = Favorit konnte nicht entfernt werden
errors-tokens-favorite-update-failed = Favorit konnte nicht aktualisiert werden
errors-tokens-detail-not-found = Token in Datenbank oder externen Quellen nicht gefunden
errors-tokens-fetch-failed = Token konnte nicht abgerufen werden
errors-tokens-refresh-all-failed = Alle Datenquellen sind fehlgeschlagen
errors-tokens-refresh-failed = Token konnte nicht aktualisiert werden
errors-tokens-search-query-required = Der Suchparameter 'q' ist erforderlich
errors-tokens-search-failed = Token-Suche fehlgeschlagen

errors-actions-not-found = Aktion { $id } nicht gefunden
errors-services-not-found = Dienst '{ $name }' nicht gefunden
