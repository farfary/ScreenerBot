config-events-record-token = Token-Ereignisse aufzeichnen
    .hint = Token-bezogene Ereignisse aufzeichnen (Blacklist, Metadaten, Dezimalstellen)
config-events-record-trader = Trader-Ereignisse aufzeichnen
