config-trader-stop-loss-threshold-pct = Stop-Loss-Schwelle %
    .hint = Ausstieg, wenn der Verlust diesen Wert in % überschreitet (50 = Ausstieg bei -50 %)
    .unit = %
config-trader-time-override-duration = Dauer des Zeit-Overrides
    .hint = Dauer bis zum erzwungenen Ausstieg (168 Stunden = 7 Tage, 30 Minuten usw.)
config-trader-time-override-enabled = Zeit-Override aktivieren
    .hint = Automatischen Ausstieg für Positionen aktivieren, die zu lange im Verlust gehalten werden
config-trader-time-override-loss-threshold-percent = Verlust % für Zeit-Override
    .hint = Verlust in %, der den Zeit-Override auslöst (-40 = Ausstieg bei 40 % Minus)
    .unit = %
config-trader-time-override-unit = Einheit des Zeit-Overrides
    .hint = Zeiteinheit: seconds, minutes, hours, days
config-trader-trade-size-sol = Trade-Größe
    .hint = SOL pro Position (0.005-0.01 zum Testen)
    .unit = SOL

## updates

config-updates-auto-check = Nach Updates suchen
    .hint = Regelmäßig bei screenerbot.io nachfragen, ob eine neuere Version veröffentlicht wurde
config-updates-auto-download = Automatisch herunterladen
    .hint = Eine neue Version im Hintergrund abrufen und prüfen, sobald sie gefunden wird
config-updates-auto-install = Automatisch installieren
    .hint = Ein geprüftes Core-Update selbstständig mit kurzem Backend-Neustart anwenden. Deaktivieren Sie dies, um vorher gefragt zu werden.
config-updates-check-interval-hours = Prüfintervall
    .hint = Wie oft nach einer neueren Version gesucht wird
    .unit = Stunden
config-updates-defer-while-trading = Beim Trading warten
    .hint = Den Neustart verschieben, solange Positionen offen sind. Das Update wird beim nächsten Start von { -brand } dennoch angewendet.
config-updates-notify-telegram = Auf { -telegram } ankündigen
    .hint = Eine { -telegram }-Nachricht senden, wenn ein Update gefunden, bereitgestellt oder angewendet wird

## wallet

config-wallet-api-response-cache-ttl-secs = TTL des API-Antwort-Caches
    .hint = Sekunden, für die Antworten des Wallet-Dashboards im Speicher zwischengespeichert werden
    .unit = Sekunden
config-wallet-daily-flow-decimate-threshold-days = Schwelle für die Ausdünnung des Tagesflusses
    .hint = Tage, ab denen ältere Daten ausgedünnt werden
    .unit = Tage
config-wallet-dashboard-metrics-24h-interval-secs = Aktualisierung Dashboard-Kennzahlen (24 Std.)
    .hint = Sekunden zwischen den Vorberechnungen der 24-Std.-Dashboard-Kennzahlen
    .unit = Sekunden
config-wallet-dashboard-metrics-30d-interval-secs = Aktualisierung Dashboard-Kennzahlen (30 T.)
    .hint = Sekunden zwischen den Vorberechnungen der 30-Tage-Dashboard-Kennzahlen
    .unit = Sekunden
config-wallet-dashboard-metrics-7d-interval-secs = Aktualisierung Dashboard-Kennzahlen (7 T.)
    .hint = Sekunden zwischen den Vorberechnungen der 7-Tage-Dashboard-Kennzahlen
    .unit = Sekunden
config-wallet-dashboard-metrics-alltime-interval-secs = Aktualisierung Dashboard-Kennzahlen (Gesamtzeitraum)
    .hint = Sekunden zwischen den Vorberechnungen der Dashboard-Kennzahlen für den Gesamtzeitraum
    .unit = Sekunden
config-wallet-flow-cache-backfill-batch = Batchgröße des Flow-Caches
    .hint = Maximal neue Transaktionen, die pro Synchronisierung verarbeitet werden
    .unit = Zeilen
config-wallet-flow-cache-lookback-secs = Rückblick des Flow-Caches
    .hint = Sicherheits-Rückblick beim Fortsetzen der Synchronisierung (Sekunden)
    .unit = Sekunden
config-wallet-flow-cache-update-secs = Aktualisierung des Flow-Caches
    .hint = Sekunden zwischen den Synchronisierungen des SOL-Flow-Caches aus der Transaktionsdatenbank
    .unit = Sekunden
config-wallet-max-daily-flow-days = Max. Tage des Tagesflusses
    .hint = Maximal zurückgegebene Tage an Tagesflussdaten (harte Obergrenze)
    .unit = Tage
config-wallet-min-balance-sol = Minimales SOL-Guthaben
    .hint = Für Swaps erforderliches minimales SOL-Guthaben (Sicherheitsschwelle)
    .unit = SOL
config-wallet-snapshot-interval-secs = Snapshot-Intervall
    .hint = Sekunden zwischen regelmäßigen Snapshots des Wallet-Guthabens. Dies ist nur der Rückfall – jede On-Chain-Aktivität aktualisiert das Guthaben innerhalb von Sekunden
    .unit = Sekunden
config-wallet-watch-enabled = Beobachtung aktiviert
    .hint = Hauptschalter für den Wallet-Beobachtungsdienst. Die eigene Wallet wird unabhängig von dieser Einstellung immer beobachtet
config-wallet-watch-high-activity-interval-secs = Beobachtungsintervall bei hoher Aktivität
    .hint = Minimale Sekunden zwischen Prüfungen erfolgreicher Transaktionen, nachdem eine hochaktive Wallet neue Aktivität signalisiert
    .unit = Sekunden
config-wallet-watch-max-targets = Max. Beobachtungsziele
    .hint = Maximale Anzahl eingefügter Adressen, die gleichzeitig beobachtet werden können (Schutz für Abonnement und RPC-Budget)
    .unit = Ziele
config-wallet-watch-poll-fallback-secs = Fallback-Abfrageintervall der Beobachtung
    .hint = Sekunden zwischen eskalierten Signatur-Abfragen, solange das gemeinsame Abonnement nicht verbunden ist
    .unit = Sekunden
config-wallet-watch-poll-interval-secs = Abfrageintervall der Beobachtung
    .hint = Sekunden zwischen Basis-Signaturabfragen pro Ziel, als Sicherheitsnetz bei einem stillen WebSocket-Abbruch
    .unit = Sekunden
config-wallet-watch-retention-days = Aufbewahrung der Beobachtung
    .hint = Tage, für die dekodierte Transaktionszeilen einer beobachteten (fremden) Wallet aufbewahrt werden, bevor sie gelöscht werden
    .unit = Tage

## webserver

config-webserver-auth-custom-title = Eigener Anmeldetitel
    .hint = Eigener Titel auf der Anmeldeseite. Leer lassen für den Standard.
config-webserver-auth-enabled = Authentifizierung aktivieren
    .hint = Passwort für den Zugriff auf das Dashboard im Headless-Modus verlangen. Passwort per CLI oder API festlegen.
