## account

config-account-auto-wallet-signin = Automatisch mit meiner Wallet anmelden
    .hint = Wenn diese Wallet bereits ein { -brand }-Konto hat, wird beim Start ohne Nachfrage angemeldet. Standardmäßig aus: Eine Nachricht mit Ihrem Trading-Schlüssel zu signieren sollte Ihre eigene Entscheidung sein, nicht die des Bots.
config-account-refresh-margin-secs = Vorlauf für Token-Erneuerung (Sekunden)
    .hint = Wie früh das Anmelde-Token vor Ablauf erneuert wird. Ändern Sie dies nur, wenn Sie die Authentifizierung debuggen.
config-account-use-gateway-rpc = { -brand }-RPC zum Senden von Transaktionen verwenden
    .hint = Signierte Swap-Transaktionen über screenerbot.io statt über Ihren eigenen RPC senden. Das Signieren erfolgt immer auf diesem Rechner; der Server kann eine signierte Transaktion nicht verändern. Für Preisdaten wird weiterhin Ihr eigener RPC benötigt.

## agent_control

config-agent-control-analysis = Analyse-Tools
    .hint = Berechtigungsstufe für Analyse-Tools (allow, ask_user, deny)
    .placeholder = allow
config-agent-control-config = Konfigurations-Tools
    .hint = Berechtigungsstufe für Konfigurations-Tools (allow, ask_user, deny). Jede Einstellung der App ist erreichbar, einschließlich RPC-Endpunkten; private Wallet-Schlüssel sind für einen Agenten auf keiner Stufe les- oder schreibbar
    .placeholder = allow
config-agent-control-enabled = Agent-Steuerung aktivieren
    .hint = Aktiviert die authentifizierte Loopback-Agent-Bridge und den stdio-MCP-Adapter. Nicht gekoppelte Clients erhalten keine Tools
config-agent-control-portfolio = Portfolio-Tools
    .hint = Berechtigungsstufe für Portfolio-Tools (allow, ask_user, deny)
    .placeholder = allow
config-agent-control-system = System-Tools
    .hint = Berechtigungsstufe für System-Tools (allow, ask_user, deny)
    .placeholder = allow
config-agent-control-trading = Trading-Tools
    .hint = Berechtigungsstufe für Trading-Tools (allow, ask_user, deny) für den In-App-Assistenten und geplante Automatisierung. Gekoppelte Agent-Verbindungen haben eine eigene Richtlinie, einstellbar pro Verbindung unter Einstellungen -> Agent-Verbindungen
    .placeholder = allow

## assistant

config-assistant-auto-summarize = Automatisch zusammenfassen
    .hint = Lange Unterhaltungen automatisch zusammenfassen und komprimieren, um Kontext zu sparen
config-assistant-check-interval-seconds = Prüfintervall
    .hint = Wie oft der Scheduler nach auszuführenden Aufgaben sucht
    .unit = Sekunden
config-assistant-default-timeout-seconds = Standard-Timeout
    .hint = Maximale Laufzeit einer geplanten Aufgabe, bevor sie gestoppt wird
    .unit = Sekunden
config-assistant-enabled = Assistent aktivieren
    .hint = Chat-Oberfläche des Assistenten für interaktive Unterhaltungen aktivieren
config-assistant-event-triggers-enabled = Ereignis-Trigger
    .hint = Dem Assistenten erlauben, Aktionen anhand von Ereignissen auszulösen (aus Sicherheitsgründen standardmäßig deaktiviert)
config-assistant-max-concurrent = Max. gleichzeitige Aufgaben
    .hint = Maximale Anzahl geplanter Aufgaben, die gleichzeitig laufen können
config-assistant-max-session-messages = Max. Nachrichten pro Sitzung
    .hint = Maximale Nachrichten pro Chat-Sitzung vor der automatischen Zusammenfassung
    .unit = Nachrichten
config-assistant-scheduled-tasks-enabled = Geplante Aufgaben
    .hint = Automatisierte Assistenten-Aufgaben aktivieren, die nach Zeitplan laufen

## copy_trading

config-copy-trading-default-slippage-pct = Standard-Slippage
    .hint = Standard-Slippage für Paper- und künftige Live-Kopien
    .unit = %
config-copy-trading-enabled = Wallet-Kopie
    .hint = Verarbeitung von Copy-Aufgaben aktivieren
config-copy-trading-latency-kill-switch-enabled = Latenz-Notabschaltung
    .hint = Eine Copy-Aufgabe pausieren, wenn ihre jüngste Verzögerung zwischen Ziel und Erkennung über dem konfigurierten Limit bleibt
config-copy-trading-latency-window-size = Latenz-Stichprobenfenster
    .hint = Anzahl der jüngsten Beobachtungen, die von der Latenz-Notabschaltung verwendet werden
config-copy-trading-max-active-tasks = Maximale aktive Aufgaben
    .hint = Maximal gleichzeitig aktivierte Copy-Aufgaben; Paper- und Live-Aufgaben zählen beide, da jede ihre Wallet beobachtet
config-copy-trading-max-arrival-distance-ms = Maximale Ankunftsverzögerung
    .hint = Pausieren, wenn das nachlaufende Stichprobenfenster diese durchschnittliche Verzögerung zwischen Ziel und Erkennung überschreitet
    .unit = ms
config-copy-trading-readiness-min-closed-rounds = Runden für Live-Bereitschaft
    .hint = Geschlossene Paper-Runden, die eine Aufgabe benötigt, bevor ihre Live-Bereitschaftsprüfung besteht
config-copy-trading-require-filter-pass = Bestandene Filterung verlangen
    .hint = Nur Tokens kopieren, die von der Filterungs-Pipeline akzeptiert wurden

