    .hint = '{ -brand }' auf der Anmeldeseite anzeigen.
config-webserver-auth-totp-enabled = 2FA (TOTP) aktivieren
    .hint = Zusätzlich zum Passwort einen TOTP-Code verlangen. Einrichtung über die Dashboard-Einstellungen.
config-webserver-host = Host
    .hint = Zu bindende IP: 127.0.0.1 = nur localhost, 0.0.0.0 = alle Schnittstellen (VPS/Remote; Authentifizierung erforderlich). Erfordert Neustart.
    .placeholder = 127.0.0.1
config-webserver-port = Port
    .hint = Port für den Dashboard-Zugriff (nur Headless-Modus). Wird erst nach einem Neustart wirksam.

