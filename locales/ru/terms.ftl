## Glossary (Russian)
# Position = Позиция (f)
# Open position = Открытая позиция (f)
# Close / closed position = Закрыть позицию / Закрытая позиция (f)
# Entry = Вход (m)
# Exit = Выход (m)
# Partial exit = Частичный выход (m)
# Take profit = Тейк-профит (m)
# Stop loss = Стоп-лосс (m)
# Trailing stop = Трейлинг-стоп (m)
# DCA (dollar-cost averaging) = DCA (усреднение) (n)
# Slippage = Проскальзывание (n)
# Priority fee = Приоритетная комиссия (f)
# Pool = Пул (m)
# Liquidity = Ликвидность (f)
# Market cap = Капитализация (f)
# Volume = Объём (m)
# Holder = Холдер (m)
# Token = Токен (m)
# Mint address = Адрес минта (m)
# Wallet = Кошелёк (m)
# Main wallet = Основной кошелёк (m)
# Swap = Своп (m)
# Buy = Покупка (f) / Купить
# Sell = Продажа (f) / Продать
# Filter = Фильтр (m)
# Filtering = Фильтрация (f)
# Strategy = Стратегия (f)
# Condition = Условие (n)
# Signal = Сигнал (m)
# Paper trading = Виртуальная торговля (f)
# Copy trading = Копитрейдинг (m)
# Copy task = Задача копирования (f)
# Watchlist = Список наблюдения (m)
# Blacklist = Чёрный список (m)
# Whitelist = Белый список (m)
# Profit and loss (P&L) = Прибыль и убыток (P&L) (f/m)
# Unrealized = Нереализованная (прибыль)
# Realized = Реализованная (прибыль)
# Balance = Баланс (m)
# Dashboard = Дашборд (m)
# Settings = Настройки (pl)
# Trader (the automated trading engine) = Трейдер (m)
# Force stop = Принудительная остановка (f)
# Loss limit = Лимит убытков (m)
# Candle = Свеча (f)
# Chart = График (m)
# Transaction = Транзакция (f)
# Signature = Подпись (f)
# Rug pull = Рагпулл (m)
# Security score = Оценка безопасности (f)
# Airdrop = Airdrop (аирдроп) (m)
# Assistant (the AI assistant) = Ассистент (m)
# Provider (LLM or RPC provider) = Провайдер (m)
# Endpoint = Эндпоинт (m)
# Scheduled task = Запланированная задача (f)
# Notification = Уведомление (n)
# Explore Mode = Режим обзора (m)
# Backfill = Дозагрузка (f)
# Holding (tokens held) = Актив в кошельке (m)
# Round (copy round) = Раунд (m)
# Arm live = Включить боевой режим (m)
# Kill switch = Аварийный выключатель (m)
# Authority (mint/freeze) = Полномочия (mint/freeze) (pl)
# Sub-wallet = Дополнительный кошелёк (m)
# Secondary wallet = Второстепенный кошелёк (m)
# Instruction (assistant) = Инструкция (f)
# Instruction (on-chain) = Инструкция (f)
# Model (LLM) = Модель (f)
# Confidence = Уверенность (f)
# Latency = Задержка (f)
# Boost / boosted = Буст (m) / с бустом
# Featured = Избранное (n) / рекомендуемый
# Rent (token account) = Рента (f)
# Burn = Сжигание (n) / сжечь
# Reclaim = Возврат (m) / вернуть
# Passed / rejected (filter) = Пройден / отклонён
# Average (short) = Сред.
# Add (DCA add to a position) = Докупка (f)
# Cooldown = Пауза (f)
# Core (backend binary) = Ядро (n)
# System tray = Системный трей (m)
# Win rate = Доля прибыльных сделок (f)
# Time unit abbreviations = д (день) / ч (час) / мин (минута) / с (секунда)
# Snapshot = Снимок (m)
# Gap (candle gap) = Пропуск (m)
# Breakout = Пробой (m)
# Wick = Тень (f)
# Payload = Полезная нагрузка (f)
# Severity = Серьёзность (f)
# Cost basis = Базовая стоимость (f)
# Log = Журнал (m)
# Watch (wallet watch) = Отслеживание (n)
# Preview = Предпросмотр (m)
# Multi-buy / multi-sell = Мультипокупка / мультипродажа (f)
# Vanity address = Красивый адрес (m)
# Keypair = Пара ключей (f)
# Honeypot = Хонипот (m)
# Trade (noun) = Сделка (f)
# Router = Роутер (m)
# Quote (swap quote) = Котировка (f)
# Poll (noun) = Опрос (m)
# Uptime = Время работы (n)
# Insiders = Инсайдеры (pl)
# Whale = Кит (m)
# Emergency stop = Экстренная остановка (f)
# Profit factor = Профит-фактор (m)
# Drawdown = Просадка (f)
# Hold time = Время удержания (n)
# Timeframe = Таймфрейм (m)
# Moving average = Скользящая средняя (f)
# Compute units = Вычислительные единицы (pl)
# Lookback = Период просмотра (m)
# Explorer (block explorer) = Обозреватель (m)
# Consolidation = Консолидация (f)
# Top up = Пополнить / Пополнение (n)
# Trade Watcher = Наблюдатель за сделками (m)
# Holder Watch = Наблюдение за холдерами (n)
# Prompt (LLM) = Промпт (m)
# Amount = Сумма (f)
# Deployer = Деплоер (m)
# ON / OFF = Вкл. / Выкл.

