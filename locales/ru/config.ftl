config-wallet-watch-high-activity-interval-secs = Интервал наблюдения при высокой активности
    .hint = Минимум секунд между проверками успешных транзакций после того, как высокоактивный кошелёк сигнализирует о новой активности
    .unit = с
config-wallet-watch-max-targets = Макс. целей наблюдения
    .hint = Максимальное число вставленных адресов, которые можно отслеживать одновременно (защита бюджета подписок и RPC)
    .unit = целей
config-wallet-watch-poll-fallback-secs = Резервный интервал опроса наблюдения
    .hint = Секунд между усиленными опросами подписей, пока общая подписка не подключена
    .unit = с
config-wallet-watch-poll-interval-secs = Интервал опроса наблюдения
    .hint = Секунд между базовыми опросами подписей для каждой цели — страховка на случай тихого обрыва WebSocket
    .unit = с
config-wallet-watch-retention-days = Срок хранения данных наблюдения
    .hint = Сколько дней хранить расшифрованные строки транзакций отслеживаемого (не собственного) кошелька до удаления
    .unit = дн.

## webserver

config-webserver-auth-custom-title = Свой заголовок входа
    .hint = Свой заголовок на странице входа. Оставьте пустым для значения по умолчанию.
config-webserver-auth-enabled = Включить аутентификацию
    .hint = Требовать пароль для доступа к дашборду в безголовом режиме. Пароль задаётся через CLI или API.
config-webserver-auth-session-timeout-secs = Тайм-аут сессии
    .hint = Через какое время сессия истекает и требуется повторный вход. 0 — не истекает.
config-webserver-auth-show-logo = Показывать логотип
    .hint = Показывать логотип { -brand } на странице входа.
config-webserver-auth-show-name = Показывать название приложения
    .hint = Показывать «{ -brand }» на странице входа.
config-webserver-auth-totp-enabled = Включить 2FA (TOTP)
    .hint = Требовать код TOTP в дополнение к паролю. Настраивается в настройках дашборда.
config-webserver-host = Хост
    .hint = IP для привязки: 127.0.0.1 — только localhost, 0.0.0.0 — все интерфейсы (VPS/удалённый доступ; требуется аутентификация). Требуется перезапуск.
    .placeholder = 127.0.0.1
config-webserver-port = Порт
    .hint = Порт для доступа к дашборду (только безголовый режим). Для вступления в силу требуется перезапуск.

