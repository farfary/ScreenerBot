config-chain-rpc-stats-enabled = Статистика включена
    .hint = Включить сбор статистики RPC
config-chain-rpc-triton-rate-limit = Лимит запросов Triton
    .hint = Число запросов в секунду для провайдера Triton
    .unit = зап./с
config-chain-rpc-urls = URL RPC
    .hint = RPC-эндпоинты через запятую (по кругу)
