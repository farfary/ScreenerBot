## Glossary (Turkish)
# Position = Pozisyon
# Open position = Açık pozisyon
# Close / closed position = Pozisyonu kapat / kapalı pozisyon
# Entry = Giriş
# Exit = Çıkış
# Partial exit = Kısmi çıkış
# Take profit = Kâr al
# Stop loss = Zarar durdur
# Trailing stop = İz süren stop
# DCA (dollar-cost averaging) = DCA (maliyet ortalaması)
# Slippage = Kayma (slippage)
# Priority fee = Öncelik ücreti
# Pool = Havuz
# Liquidity = Likidite
# Market cap = Piyasa değeri
# Volume = Hacim
# Holder = Holder
# Token = Token
# Mint address = Mint adresi
# Wallet = Cüzdan
# Main wallet = Ana cüzdan
# Swap = Takas
# Buy = Al
# Sell = Sat
# Filter = Filtre
# Filtering = Filtreleme
# Strategy = Strateji
# Condition = Koşul
# Signal = Sinyal
# Paper trading = Sanal işlem
# Copy trading = Kopya işlem
# Copy task = Kopyalama görevi
# Watchlist = İzleme listesi
# Blacklist = Kara liste
# Whitelist = Beyaz liste
# Profit and loss (P&L) = Kâr ve zarar (K/Z)
# Unrealized = Gerçekleşmemiş
# Realized = Gerçekleşmiş
# Balance = Bakiye
# Dashboard = Panel
# Settings = Ayarlar
# Trader (the automated trading engine) = Trader
# Force stop = Zorla durdur
# Loss limit = Zarar limiti
# Candle = Mum
# Chart = Grafik
# Transaction = İşlem (zincir üstü: transfer)
# Signature = İmza
# Rug pull = Rug pull
# Security score = Güvenlik puanı
# Airdrop = Airdrop
# Assistant (the AI assistant) = Asistan
# Provider (LLM or RPC provider) = Sağlayıcı
# Endpoint = Uç nokta
# Scheduled task = Zamanlanmış görev
# Notification = Bildirim
# Explore Mode = Keşif Modu
# Backfill = Geçmiş veri doldurma
# Holding (tokens held) = Varlık
# Round (copy round) = Tur
# Arm live = Canlıyı etkinleştir
# Kill switch = Acil durdurma anahtarı
# Authority (mint/freeze) = Yetki
# Sub-wallet = Alt cüzdan
# Secondary wallet = İkincil cüzdan
# Instruction (assistant) = Talimat
# Instruction (on-chain) = Komut (zincir üstü)
# Model (LLM) = Model
# Confidence = Güven
# Latency = Gecikme
# Boost / boosted = Boost / boost'lu
# Featured = Öne çıkan
# Rent (token account) = Kira (rent)
# Burn = Yak
# Reclaim = Geri al
# Passed / rejected (filter) = Geçti / reddedildi
# Average (short) = Ort.
# Add (DCA add to a position) = Ekleme
# Cooldown = Bekleme süresi
# Core (backend binary) = Çekirdek
# System tray = Sistem tepsisi
# Win rate = Kazanma oranı
# Time unit abbreviations = g (gün) / sa (saat) / dk (dakika) / sn (saniye)
# Snapshot = Anlık görüntü
# Gap (candle gap) = Boşluk
# Breakout = Kırılım
# Wick = Fitil
# Payload = Yük (payload)
# Severity = Önem derecesi
# Cost basis = Maliyet bazı
# Log = Günlük
# Watch (wallet watch) = İzleme
# Preview = Önizleme
# Multi-buy / multi-sell = Çoklu alım / çoklu satım
# Vanity address = Özel (vanity) adres
# Keypair = Anahtar çifti
# Honeypot = Honeypot
# Trade (noun) = İşlem (alım-satım)
# Router = Yönlendirici
# Quote (swap quote) = Fiyat teklifi
# Poll (noun) = Yoklama
# Uptime = Çalışma süresi
# Insiders = İçeridekiler
# Whale = Balina
# Emergency stop = Acil durdurma
# Profit factor = Kâr faktörü
# Drawdown = Düşüş (drawdown)
# Hold time = Tutma süresi
# Timeframe = Zaman dilimi
# Moving average = Hareketli ortalama
# Compute units = Hesaplama birimi
# Lookback = Geriye bakış
# Explorer (block explorer) = Gezgin
# Consolidation = Birleştirme
# Top up = Bakiye yükle
# Trade Watcher = İşlem İzleyici
# Holder Watch = Holder İzleme
# Prompt (LLM) = İstem
# Amount = Miktar
# Deployer = Dağıtıcı
# ON / OFF = Açık / Kapalı

