config-wallet-flow-cache-lookback-secs = Lookback Cache Aliran
    .hint = Lookback pengaman saat melanjutkan sinkronisasi (detik)
    .unit = detik
config-wallet-flow-cache-update-secs = Pembaruan Cache Aliran
    .hint = Detik antara sinkronisasi cache aliran SOL dari DB transaksi
    .unit = detik
config-wallet-max-daily-flow-days = Maks Hari Aliran Harian
    .hint = Hari maksimum data aliran harian yang dikembalikan (batas keras)
    .unit = hari
config-wallet-min-balance-sol = Saldo SOL Minimum
    .hint = Saldo SOL minimum yang diperlukan untuk swap (ambang keamanan)
    .unit = SOL
config-wallet-snapshot-interval-secs = Interval Snapshot
    .hint = Detik antara snapshot saldo dompet berkala. Ini hanya cadangan — aktivitas on-chain apa pun menyegarkan saldo dalam hitungan detik
    .unit = detik
config-wallet-watch-enabled = Pantau Aktif
    .hint = Sakelar utama untuk layanan pengamatan dompet. Dompet sendiri selalu dipantau terlepas dari pengaturan ini
config-wallet-watch-high-activity-interval-secs = Interval Pantau Aktivitas Tinggi
    .hint = Detik minimum antara pemeriksaan transaksi berhasil setelah dompet berdaya aktivitas tinggi menandakan aktivitas baru
    .unit = detik
config-wallet-watch-max-targets = Maks Target Pantau
    .hint = Jumlah maksimum alamat tempelan yang dapat dipantau sekaligus (pengaman langganan + anggaran RPC)
    .unit = target
config-wallet-watch-poll-fallback-secs = Interval Fallback Polling Pantau
    .hint = Detik antara polling signature yang ditingkatkan saat langganan bersama tidak terhubung
    .unit = detik
config-wallet-watch-poll-interval-secs = Interval Polling Pantau
    .hint = Detik antara polling signature dasar per target, sebagai jaring pengaman jika WebSocket terputus tanpa suara
    .unit = detik
config-wallet-watch-retention-days = Retensi Pantau
    .hint = Hari untuk menyimpan baris transaksi terdekode dari dompet yang dipantau (bukan milik sendiri) sebelum dihapus
    .unit = hari

## webserver

config-webserver-auth-custom-title = Judul Login Kustom
    .hint = Judul kustom yang ditampilkan di halaman login. Biarkan kosong untuk default.
config-webserver-auth-enabled = Aktifkan Autentikasi
    .hint = Wajibkan kata sandi untuk mengakses dasbor dalam mode headless. Atur kata sandi melalui CLI atau API.
config-webserver-auth-session-timeout-secs = Batas Waktu Sesi
    .hint = Berapa lama sebelum sesi berakhir dan perlu login ulang. 0 = tidak pernah berakhir.
config-webserver-auth-show-logo = Tampilkan Logo
    .hint = Tampilkan logo { -brand } di halaman login.
config-webserver-auth-show-name = Tampilkan Nama Aplikasi
    .hint = Tampilkan '{ -brand }' di halaman login.
config-webserver-auth-totp-enabled = Aktifkan 2FA (TOTP)
    .hint = Wajibkan kode TOTP selain kata sandi. Atur melalui pengaturan dasbor.
config-webserver-host = Host
    .hint = IP untuk bind: 127.0.0.1 = hanya localhost, 0.0.0.0 = semua antarmuka (VPS/jarak jauh; autentikasi diperlukan). Memerlukan restart.
    .placeholder = 127.0.0.1
config-webserver-port = Port
    .hint = Port untuk akses dasbor (hanya mode headless). Memerlukan restart agar berlaku.

