config-updates-auto-download = Tải xuống tự động
    .hint = Lấy và xác minh bản phát hành mới trong nền ngay khi tìm thấy
config-updates-auto-install = Cài đặt tự động
    .hint = Tự áp dụng bản cập nhật core đã xác minh, kèm một lần khởi động lại backend ngắn. Tắt tùy chọn này để được hỏi trước.
config-updates-check-interval-hours = Chu kỳ kiểm tra
    .hint = Tần suất kiểm tra bản phát hành mới hơn
    .unit = giờ
config-updates-defer-while-trading = Chờ khi đang giao dịch
    .hint = Hoãn việc khởi động lại khi còn vị thế đang mở. Bản cập nhật vẫn được áp dụng vào lần { -brand } khởi động tiếp theo.
config-updates-notify-telegram = Thông báo trên { -telegram }
    .hint = Gửi tin nhắn { -telegram } khi tìm thấy, chuẩn bị hoặc áp dụng một bản cập nhật

config-wallet-api-response-cache-ttl-secs = Thời hạn bộ nhớ đệm phản hồi API
    .hint = Số giây lưu đệm phản hồi bảng điều khiển ví trong bộ nhớ
    .unit = giây
config-wallet-daily-flow-decimate-threshold-days = Ngưỡng giảm mẫu dòng tiền hằng ngày
    .hint = Ngưỡng số ngày mà dữ liệu cũ hơn sẽ được giảm mẫu
    .unit = ngày
config-wallet-dashboard-metrics-24h-interval-secs = Cập nhật chỉ số bảng điều khiển (24h)
    .hint = Số giây giữa các lần tính trước chỉ số bảng điều khiển 24h
    .unit = giây
config-wallet-dashboard-metrics-30d-interval-secs = Cập nhật chỉ số bảng điều khiển (30d)
    .hint = Số giây giữa các lần tính trước chỉ số bảng điều khiển 30d
    .unit = giây
config-wallet-dashboard-metrics-7d-interval-secs = Cập nhật chỉ số bảng điều khiển (7d)
    .hint = Số giây giữa các lần tính trước chỉ số bảng điều khiển 7d
    .unit = giây
config-wallet-dashboard-metrics-alltime-interval-secs = Cập nhật chỉ số bảng điều khiển (mọi thời điểm)
    .hint = Số giây giữa các lần tính trước chỉ số bảng điều khiển mọi thời điểm
    .unit = giây
config-wallet-flow-cache-backfill-batch = Kích thước lô bộ nhớ đệm dòng tiền
    .hint = Số giao dịch mới tối đa xử lý mỗi lần đồng bộ
    .unit = dòng
config-wallet-flow-cache-lookback-secs = Khoảng nhìn lại của bộ nhớ đệm dòng tiền
    .hint = Khoảng nhìn lại an toàn khi tiếp tục đồng bộ (giây)
    .unit = giây
config-wallet-flow-cache-update-secs = Cập nhật bộ nhớ đệm dòng tiền
    .hint = Số giây giữa các lần đồng bộ bộ nhớ đệm dòng SOL từ CSDL giao dịch
    .unit = giây
config-wallet-max-daily-flow-days = Số ngày dòng tiền hằng ngày tối đa
    .hint = Số ngày dữ liệu dòng tiền hằng ngày tối đa được trả về (giới hạn cứng)
    .unit = ngày
config-wallet-min-balance-sol = Số dư SOL tối thiểu
    .hint = Số dư SOL tối thiểu cần có để swap (ngưỡng an toàn)
    .unit = SOL
config-wallet-snapshot-interval-secs = Chu kỳ ảnh chụp nhanh
    .hint = Số giây giữa các ảnh chụp nhanh số dư ví định kỳ. Đây chỉ là lớp dự phòng — mọi hoạt động on-chain đều làm mới số dư trong vài giây
    .unit = giây
config-wallet-watch-enabled = Bật theo dõi
    .hint = Công tắc chính cho dịch vụ quan sát ví. Ví của chính bạn luôn được theo dõi bất kể cài đặt này
config-wallet-watch-high-activity-interval-secs = Chu kỳ theo dõi hoạt động cao
    .hint = Số giây tối thiểu giữa các lần kiểm tra giao dịch thành công sau khi một ví hoạt động cao báo có hoạt động mới
    .unit = giây
config-wallet-watch-max-targets = Số mục tiêu theo dõi tối đa
    .hint = Số địa chỉ đã dán tối đa có thể theo dõi cùng lúc (bảo vệ ngân sách đăng ký + RPC)
    .unit = mục tiêu
config-wallet-watch-poll-fallback-secs = Chu kỳ thăm dò dự phòng khi theo dõi
    .hint = Số giây giữa các lần thăm dò chữ ký được đẩy nhanh khi đăng ký dùng chung chưa kết nối
    .unit = giây
config-wallet-watch-poll-interval-secs = Chu kỳ thăm dò khi theo dõi
    .hint = Số giây giữa các lần thăm dò chữ ký cơ sở cho mỗi mục tiêu, làm lưới an toàn khi WebSocket bị rớt âm thầm
    .unit = giây
config-wallet-watch-retention-days = Thời gian lưu dữ liệu theo dõi
    .hint = Số ngày giữ các dòng giao dịch đã giải mã của ví được theo dõi (không phải ví của bạn) trước khi bị xóa
    .unit = ngày

config-webserver-auth-custom-title = Tiêu đề đăng nhập tùy chỉnh
    .hint = Tiêu đề tùy chỉnh hiển thị trên trang đăng nhập. Để trống để dùng mặc định.
config-webserver-auth-enabled = Bật xác thực
    .hint = Yêu cầu mật khẩu để truy cập bảng điều khiển ở chế độ headless. Đặt mật khẩu qua CLI hoặc API.
config-webserver-auth-session-timeout-secs = Thời gian chờ phiên
    .hint = Thời gian trước khi phiên hết hạn và yêu cầu đăng nhập lại. 0 = không bao giờ hết hạn.
config-webserver-auth-show-logo = Hiện logo
    .hint = Hiển thị logo { -brand } trên trang đăng nhập.
config-webserver-auth-show-name = Hiện tên ứng dụng
    .hint = Hiển thị '{ -brand }' trên trang đăng nhập.
config-webserver-auth-totp-enabled = Bật 2FA (TOTP)
    .hint = Yêu cầu mã TOTP ngoài mật khẩu. Thiết lập trong cài đặt bảng điều khiển.
config-webserver-host = Host
    .hint = IP để bind: 127.0.0.1 = chỉ localhost, 0.0.0.0 = mọi giao diện (VPS/từ xa; bắt buộc xác thực). Cần khởi động lại.
    .placeholder = 127.0.0.1
config-webserver-port = Port
    .hint = Port để truy cập bảng điều khiển (chỉ ở chế độ headless). Cần khởi động lại để có hiệu lực.

