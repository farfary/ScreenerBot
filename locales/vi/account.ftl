account-data-access-ready = Dữ liệu { -brand } đang hoạt động
    .detail = Biểu đồ, dữ liệu pool và báo cáo bảo mật được tải từ screenerbot.io.

account-data-access-disabled = Dữ liệu { -brand } đã tắt
    .detail = Nguồn { -brand } đang bị tắt trong phần cài đặt của bạn, nên dữ liệu chỉ lấy từ các nhà cung cấp công khai.

account-data-access-offline = Dữ liệu { -brand } đang ngoại tuyến
    .detail = Không có kết nối mạng. Dữ liệu sẽ tự tiếp tục khi kết nối được khôi phục.

account-data-access-signed-out = Dữ liệu { -brand } cần có tài khoản
    .detail = Biểu đồ, pool và báo cáo bảo mật sẽ lấy từ các nhà cung cấp công khai. Các nguồn này chậm hơn, bị giới hạn tần suất và có ít dữ liệu lịch sử hơn. Đăng nhập miễn phí và không thay đổi cách { -brand } vận hành.

account-data-access-reauthorization-required = Dữ liệu { -brand } yêu cầu bạn đăng nhập lại
    .detail = Thiết bị này được cấp quyền trước khi dữ liệu { -brand } ra đời. Hãy đăng nhập lại để khôi phục; trong lúc đó, các nhà cung cấp công khai đang được sử dụng.

account-data-access-version-unsupported = Dữ liệu { -brand } cần phiên bản mới hơn
    .detail = Phiên bản này không còn được hỗ trợ. Hãy cập nhật lên { $minimum } trở lên để dùng lại dữ liệu { -brand }; trong lúc đó, các nhà cung cấp công khai đang được sử dụng.

account-data-access-unreachable = Dữ liệu { -brand } không phản hồi
    .detail = Dịch vụ không trả lời. Các nhà cung cấp công khai đang được sử dụng và { -brand } sẽ tiếp tục thử lại.

account-data-access-unknown = Dữ liệu { -brand } chưa được kiểm tra
    .detail = { -brand } chưa tải dữ liệu này trong phiên này.

