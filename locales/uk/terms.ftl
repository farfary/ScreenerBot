## Glossary (Ukrainian)
# Position = позиція (f)
# Open position = відкрита позиція (f)
# Close / closed position = закрити позицію / закрита позиція (f)
# Entry = вхід (m)
# Exit = вихід (m)
# Partial exit = частковий вихід (m)
# Take profit = тейк-профіт (m)
# Stop loss = стоп-лос (m)
# Trailing stop = трейлінг-стоп (m)
# DCA (dollar-cost averaging) = DCA (усереднення) (n)
# Slippage = проковзування (n)
# Priority fee = пріоритетна комісія (f)
# Pool = пул (m)
# Liquidity = ліквідність (f)
# Market cap = ринкова капіталізація (f)
# Volume = обсяг (m)
# Holder = холдер (m)
# Token = токен (m)
# Mint address = адреса мінта (f)
# Wallet = гаманець (m)
# Main wallet = основний гаманець (m)
# Swap = своп (m)
# Buy = купівля (f) / купити
# Sell = продаж (m) / продати
# Filter = фільтр (m)
# Filtering = фільтрація (f)
# Strategy = стратегія (f)
# Condition = умова (f)
# Signal = сигнал (m)
# Paper trading = віртуальна торгівля (f)
# Copy trading = копітрейдинг (m)
# Copy task = копі-завдання (n)
# Watchlist = список відстеження (m)
# Blacklist = чорний список (m)
# Whitelist = білий список (m)
# Profit and loss (P&L) = прибуток і збиток (P&L) (m)
# Unrealized = нереалізований
# Realized = реалізований
# Balance = баланс (m)
# Dashboard = панель керування (f)
# Settings = налаштування (n, pl)
# Trader (the automated trading engine) = трейдер (m)
# Force stop = примусова зупинка (f)
# Loss limit = ліміт збитків (m)
# Candle = свічка (f)
# Chart = графік (m)
# Transaction = транзакція (f)
# Signature = підпис (m)
# Rug pull = рагпул (m)
# Security score = оцінка безпеки (f)
# Airdrop = аірдроп (m)
# Assistant (the AI assistant) = асистент (m)
# Provider (LLM or RPC provider) = провайдер (m)
# Endpoint = ендпоінт (m)
# Scheduled task = заплановане завдання (n)
# Notification = сповіщення (n)
# Explore Mode = режим огляду (m)
# Backfill = дозавантаження історії (n)
# Holding (tokens held) = утримувані токени (m, pl)
# Round (copy round) = раунд (m)
# Arm live = активувати реальну торгівлю (f)
# Kill switch = аварійний вимикач (m)
# Authority (mint/freeze) = повноваження (n) (мінта/заморожування)
# Sub-wallet = субгаманець (m)
# Secondary wallet = додатковий гаманець (m)
# Instruction (assistant) = інструкція (f)
# Instruction (on-chain) = інструкція (f) (ончейн)
# Model (LLM) = модель (f)
# Confidence = впевненість (f)
# Latency = затримка (f)
# Boost / boosted = буст (m) / з бустом
# Featured = рекомендоване (n)
# Rent (token account) = рента (f)
# Burn = спалення (n) / спалити
# Reclaim = повернення (n) / повернути
# Passed / rejected (filter) = пройдено / відхилено
# Average (short) = сер.
# Add (DCA add to a position) = докупівля (f)
# Cooldown = пауза (f)
# Core (backend binary) = ядро (n)
# System tray = системний трей (m)
# Win rate = відсоток виграшних угод (m)
# Time unit abbreviations = д / год / хв / с
# Snapshot = знімок (m)
# Gap (candle gap) = розрив (m)
# Breakout = пробій (m)
# Wick = тінь (f)
# Payload = корисне навантаження (n)
# Severity = серйозність (f)
# Cost basis = собівартість (f)
# Log = журнал (m)
# Watch (wallet watch) = стеження (n)
# Preview = попередній перегляд (m)
# Multi-buy / multi-sell = мультикупівля (f) / мультипродаж (m)
# Vanity address = красива адреса (f)
# Keypair = пара ключів (f)
# Honeypot = ханіпот (m)
# Trade (noun) = угода (f)
# Router = маршрутизатор (m)
# Quote (swap quote) = котирування (n)
# Poll (noun) = опитування (n)
# Uptime = аптайм (m)
# Insiders = інсайдери (m, pl)
# Whale = кит (m)
# Emergency stop = екстрена зупинка (f)
# Profit factor = профіт-фактор (m)
# Drawdown = просадка (f)
# Hold time = час утримання (m)
# Timeframe = таймфрейм (m)
# Moving average = ковзна середня (f)
# Compute units = обчислювальні одиниці (f, pl)
# Lookback = глибина огляду (f)
# Explorer (block explorer) = оглядач блоків (m)
# Consolidation = консолідація (f)
# Top up = поповнення (n) / поповнити
# Trade Watcher = Trade Watcher (m)
# Holder Watch = Holder Watch (m)
# Prompt (LLM) = промпт (m)
# Amount = сума (f)
# Deployer = деплойер (m)
# ON / OFF = увімкнено / вимкнено

