    .unit = зап./с
config-chain-rpc-max-retries = Макс. повторів
    .hint = Максимальна кількість повторних спроб у разі збою
    .unit = повт.
config-chain-rpc-pool-connections-per-host = З’єднань на хост
    .hint = Розмір пулу HTTP-з’єднань на хост
    .unit = з'єдн.
config-chain-rpc-pool-idle-timeout-secs = Тайм-аут простою пулу
    .hint = Тайм-аут простою з’єднання в пулі
    .unit = с
config-chain-rpc-public-rate-limit = Ліміт запитів публічних ендпоінтів
    .hint = Запитів за секунду для публічних ендпоінтів
    .unit = зап./с
config-chain-rpc-quicknode-rate-limit = Ліміт запитів { -quicknode }
    .hint = Запитів за секунду для провайдера { -quicknode }
    .unit = зап./с
config-chain-rpc-request-timeout-secs = Тайм-аут запиту
    .hint = Тайм-аут окремих RPC-запитів
    .unit = с
config-chain-rpc-retry-base-delay-ms = Базова затримка повтору
    .hint = Початкова затримка перед першим повтором (експоненційне відступання)
    .unit = ms
config-chain-rpc-retry-max-delay-ms = Макс. затримка повтору
    .hint = Максимальна затримка між повторами
    .unit = ms
config-chain-rpc-selection-strategy = Стратегія вибору
    .hint = Стратегія вибору провайдера: adaptive, round_robin, priority, latency
config-chain-rpc-stats-enabled = Статистику ввімкнено
    .hint = Увімкнути збирання статистики RPC
config-chain-rpc-triton-rate-limit = Ліміт запитів Triton
    .hint = Запитів за секунду для провайдера Triton
    .unit = зап./с
config-chain-rpc-urls = URL-адреси RPC
    .hint = RPC-ендпоінти через кому (по колу)
    .placeholder = Введіть одне значення в рядку
config-chain-swaps = Свопи
config-chain-swaps-cost-guard = Захист від зайвих витрат
    .hint = Відхиляти своп, який витратив би SOL на акаунти, які гаманець не може повернути, незалежно від того, який маршрутизатор його побудував
config-chain-swaps-cost-guard-always-allow-below-lamports = Завжди дозволяти нижче
    .hint = Додаткові витрати, достатньо малі, щоб ігнорувати їх за будь-якого розміру угоди, тож звичайне округлення й пил ніколи не блокують своп.
    .unit = lam
config-chain-swaps-cost-guard-enabled = Увімкнено
    .hint = Симулювати кожну транзакцію агрегатора перед надсиланням і відхиляти ту, що заморожує SOL в акаунті, який гаманець не може закрити. Вимкнено означає, що маршрут може заблокувати ренту без попередження.
config-chain-swaps-cost-guard-max-extra-cost-pct = Макс. додаткові витрати
    .hint = Частка угоди, яку можна витратити на акаунти, що ніколи не повернуться до гаманця. Майданчик, який бере одноразовий депозит, приймається лише тоді, коли угода достатньо велика, щоб це виправдати.
    .unit = %
config-chain-swaps-cost-guard-retry-excluding-venue = Повторити без майданчика
    .hint = Коли майданчик відхилено, повторно запитати той самий агрегатор без цього майданчика, перш ніж переходити до іншого маршрутизатора.
config-chain-swaps-direct = Прямі свопи через пул
    .hint = Будувати інструкцію DEX самостійно, а не маршрутизувати через агрегатор
config-chain-swaps-direct-confirmation-timeout-secs = Тайм-аут підтвердження
    .hint = Як довго чекати підтвердження свопу, перш ніж повідомити про невідомий результат
    .unit = с
config-chain-swaps-direct-enabled = Увімкнено
    .hint = Отримувати котирування безпосередньо від пулу поряд з іншими ввімкненими маршрутизаторами й обирати той, що повертає найбільше після мережевих комісій.
config-chain-swaps-direct-max-price-impact-pct = Макс. вплив на ціну
    .hint = Відхиляти пряме котирування, яке зрушує пул більше за це значення — вище нього безпечніший вибір агрегатор, що розбиває ордер
    .unit = %
config-chain-swaps-direct-priority-fee-micro-lamports = Пріоритетна комісія
    .hint = Ціна обчислювальної одиниці в мікроламспортах. Вища — швидше потрапляє в завантажений блок.
    .unit = µlam/CU
config-chain-swaps-jupiter = { -jupiter }
    .hint = Маршрутизатор-агрегатор { -jupiter }
config-chain-swaps-jupiter-api-key = Ключ API
    .hint = Необов’язково. Залиште порожнім, щоб використовувати безкоштовний ендпоінт { -jupiter } (lite-api.jup.ag). Додайте ключ із portal.jup.ag, лише якщо ви впираєтеся в ліміти запитів і хочете вищої пропускної здатності (api.jup.ag). НЕ впливає на комісії за свопи чи реферальну частку доходу.
config-chain-swaps-jupiter-dynamic-compute-unit-limit = Динамічний ліміт CU
    .hint = Дозволити { -jupiter } визначати ліміт обчислювальних одиниць, симулюючи своп. Пріоритетна комісія нараховується на ліміт, тож визначений ліміт коштує менше.
config-chain-swaps-jupiter-enabled = Увімкнено
    .hint = { -jupiter } маршрутизує через усі великі DEX. Якщо вимкнути, залишаться лише прямий пул і { -raptor }, які не можуть торгувати кожним токеном.
config-chain-swaps-jupiter-priority-fee-micro-lamports = Пріоритетна комісія
    .hint = Ціна обчислювальної одиниці в мікроламспортах, та сама модель, що й у прямого пулу та { -raptor }. Вища — швидше потрапляє в завантажений блок.
    .unit = µlam/CU
config-chain-swaps-quote-deadline-ms = Термін котирувань
    .hint = Після першого коректного котирування — скільки часу інші маршрутизатори мають на відповідь, перш ніж угода пройде без них. До того часу чекаємо на кожен маршрутизатор.
    .unit = ms
config-chain-swaps-raptor = { -raptor }
    .hint = Агрегатор Solana Tracker, з якого котирування запитуються поряд з іншими маршрутизаторами
config-chain-swaps-raptor-enabled = Увімкнено
    .hint = Запитувати котирування { -raptor } поряд з іншими ввімкненими маршрутизаторами й обирати той, що повертає найбільше після мережевих комісій.
config-chain-swaps-raptor-max-hops = Макс. кроків
    .hint = Найдовший маршрут, який може побудувати { -raptor }. Більше кроків може дати кращу ціну, але коштує більше обчислень.
config-chain-swaps-raptor-priority-fee-micro-lamports = Пріоритетна комісія
    .hint = Ціна обчислювальної одиниці в мікроламспортах. Вища — швидше потрапляє в завантажений блок.
    .unit = µlam/CU
config-chains-show-preview = Блокчейни в попередньому перегляді
    .hint = Показувати блокчейни, які ще не загальнодоступні. Набирає чинності після перезапуску.
config-chains-solana = Solana

