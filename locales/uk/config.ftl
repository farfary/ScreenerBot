## account

config-account-auto-wallet-signin = Входити автоматично за допомогою мого гаманця
    .hint = Якщо для цього гаманця вже є обліковий запис { -brand }, входити під час запуску без запиту. За замовчуванням вимкнено: підписання повідомлення торговим ключем — це те, що ви маєте вирішувати самі, а не бот.
config-account-refresh-margin-secs = Запас оновлення токена
    .hint = За скільки до закінчення терміну дії оновлювати токен входу. Змінюйте, лише якщо налагоджуєте автентифікацію.
    .unit = с
config-account-use-gateway-rpc = Використовувати RPC { -brand } для надсилання транзакцій
    .hint = Транслювати підписані транзакції свопів через screenerbot.io замість вашого власного RPC. Підписання завжди відбувається на цьому комп’ютері; сервер не може змінити підписану транзакцію. Ваш власний RPC усе одно потрібен для даних про ціни.

## agent_control

config-agent-control-analysis = Інструменти аналізу
    .hint = Рівень дозволу для інструментів аналізу (allow, ask_user, deny)
    .placeholder = allow
config-agent-control-config = Інструменти конфігурації
    .hint = Рівень дозволу для інструментів конфігурації (allow, ask_user, deny). Доступні всі налаштування застосунку, зокрема RPC-ендпоінти; приватні ключі гаманців агент не може ні читати, ні змінювати на жодному рівні
    .placeholder = allow
config-agent-control-enabled = Увімкнути керування агентами
    .hint = Увімкнути автентифікований локальний міст для агентів і stdio-адаптер MCP. Неспарені клієнти не отримують жодних інструментів
config-agent-control-portfolio = Інструменти портфеля
    .hint = Рівень дозволу для інструментів портфеля (allow, ask_user, deny)
    .placeholder = allow
config-agent-control-system = Системні інструменти
    .hint = Рівень дозволу для системних інструментів (allow, ask_user, deny)
    .placeholder = allow
config-agent-control-trading = Торгові інструменти
    .hint = Рівень дозволу для торгових інструментів (allow, ask_user, deny) для вбудованого асистента та запланованої автоматизації. Спарені підключення агентів мають власну політику, що задається для кожного підключення в розділі Налаштування -> Підключення агентів
    .placeholder = allow

