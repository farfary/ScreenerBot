## wallet

config-wallet-api-response-cache-ttl-secs = Durée de vie du cache des réponses API
    .hint = Secondes de mise en cache en mémoire des réponses du tableau de bord du portefeuille
    .unit = s
config-wallet-daily-flow-decimate-threshold-days = Seuil de décimation des flux quotidiens
    .hint = Seuil en jours au-delà duquel les données plus anciennes sont décimées
    .unit = j
config-wallet-dashboard-metrics-24h-interval-secs = Mise à jour des métriques du tableau de bord (24h)
    .hint = Secondes entre deux précalculs des métriques du tableau de bord sur 24h
    .unit = s
config-wallet-dashboard-metrics-30d-interval-secs = Mise à jour des métriques du tableau de bord (30j)
    .hint = Secondes entre deux précalculs des métriques du tableau de bord sur 30j
    .unit = s
config-wallet-dashboard-metrics-7d-interval-secs = Mise à jour des métriques du tableau de bord (7j)
    .hint = Secondes entre deux précalculs des métriques du tableau de bord sur 7j
    .unit = s
config-wallet-dashboard-metrics-alltime-interval-secs = Mise à jour des métriques du tableau de bord (depuis le début)
    .hint = Secondes entre deux précalculs des métriques du tableau de bord depuis le début
    .unit = s
config-wallet-flow-cache-backfill-batch = Taille des lots du cache de flux
    .hint = Nombre maximal de nouvelles transactions traitées par synchronisation
    .unit = lignes
config-wallet-flow-cache-lookback-secs = Rétrospective du cache de flux
    .hint = Rétrospective de sécurité à la reprise de la synchronisation (secondes)
    .unit = s
config-wallet-flow-cache-update-secs = Mise à jour du cache de flux
    .hint = Secondes entre deux synchronisations du cache de flux SOL depuis la base de transactions
    .unit = s
config-wallet-max-daily-flow-days = Jours de flux quotidiens max.
    .hint = Nombre maximal de jours de données de flux quotidien renvoyés (plafond strict)
    .unit = j
config-wallet-min-balance-sol = Solde SOL minimum
    .hint = Solde SOL minimal requis pour les swaps (seuil de sécurité)
    .unit = SOL
config-wallet-snapshot-interval-secs = Intervalle des instantanés
    .hint = Secondes entre deux instantanés périodiques du solde du portefeuille. Il ne s'agit que d'un filet de sécurité : toute activité on-chain actualise le solde en quelques secondes
    .unit = s
config-wallet-watch-enabled = Surveillance activée
    .hint = Interrupteur général du service d'observation des portefeuilles. Le portefeuille de l'utilisateur est toujours surveillé, quel que soit ce réglage
config-wallet-watch-high-activity-interval-secs = Intervalle de surveillance à forte activité
    .hint = Nombre minimal de secondes entre deux vérifications de transactions réussies après qu'un portefeuille très actif signale une nouvelle activité
    .unit = s
config-wallet-watch-max-targets = Cibles surveillées max.
    .hint = Nombre maximal d'adresses collées pouvant être surveillées simultanément (garde-fou du budget d'abonnements et de RPC)
    .unit = cibles
config-wallet-watch-poll-fallback-secs = Intervalle d'interrogation de secours
    .hint = Secondes entre les interrogations de signatures renforcées tant que l'abonnement partagé n'est pas connecté
    .unit = s
config-wallet-watch-poll-interval-secs = Intervalle d'interrogation de la surveillance
    .hint = Secondes entre les interrogations de signatures de base par cible, comme filet de sécurité en cas de coupure silencieuse du WebSocket
    .unit = s
config-wallet-watch-retention-days = Conservation de la surveillance
    .hint = Nombre de jours de conservation des lignes de transactions décodées d'un portefeuille surveillé (tiers) avant leur purge
    .unit = j

## webserver

config-webserver-auth-custom-title = Titre de connexion personnalisé
    .hint = Titre personnalisé affiché sur la page de connexion. Laissez vide pour la valeur par défaut.
config-webserver-auth-enabled = Activer l'authentification
    .hint = Exige un mot de passe pour accéder au tableau de bord en mode headless. Définissez-le via la CLI ou l'API.
config-webserver-auth-session-timeout-secs = Expiration de session
    .hint = Durée avant qu'une session expire et exige une nouvelle connexion. 0 = n'expire jamais.
config-webserver-auth-show-logo = Afficher le logo
    .hint = Affiche le logo { -brand } sur la page de connexion.
config-webserver-auth-show-name = Afficher le nom de l'application
    .hint = Affiche « { -brand } » sur la page de connexion.
config-webserver-auth-totp-enabled = Activer la 2FA (TOTP)
    .hint = Exige un code TOTP en plus du mot de passe. À configurer dans les paramètres du tableau de bord.
config-webserver-host = Hôte
    .hint = IP d'écoute : 127.0.0.1 = localhost uniquement, 0.0.0.0 = toutes les interfaces (VPS/distant ; authentification requise). Redémarrage nécessaire.
    .placeholder = 127.0.0.1
config-webserver-port = Port
    .hint = Port d'accès au tableau de bord (mode headless uniquement). Redémarrage nécessaire pour prendre effet.

