# Configuration field labels. Generated once from the schema metadata; edited here from now on.
# Attributes: `.hint`, `.unit`, `.placeholder`, and `.subject` on the lower bound of a min/max pair (the parameter both bounds share).

## account

config-account-auto-wallet-signin = Se connecter automatiquement avec mon portefeuille
    .hint = Lorsque ce portefeuille possède déjà un compte { -brand }, la connexion se fait sans confirmation au démarrage. Désactivé par défaut : signer un message avec votre clé de trading est un choix qui vous revient, pas au bot.
config-account-refresh-margin-secs = Marge de renouvellement du token
    .hint = Délai d'avance avec lequel renouveler le token de connexion avant son expiration. À modifier uniquement pour déboguer l'authentification.
    .unit = s
config-account-use-gateway-rpc = Utiliser le RPC { -brand } pour envoyer les transactions
    .hint = Diffuse les transactions de swap signées via screenerbot.io plutôt que via votre propre RPC. La signature se fait toujours sur cette machine ; le serveur ne peut pas modifier une transaction signée. Votre propre RPC reste nécessaire pour les données de prix.

## agent_control

config-agent-control-analysis = Outils d'analyse
    .hint = Niveau d'autorisation des outils d'analyse (allow, ask_user, deny)
    .placeholder = allow
config-agent-control-config = Outils de configuration
    .hint = Niveau d'autorisation des outils de configuration (allow, ask_user, deny). Tous les paramètres de l'application sont accessibles, y compris les endpoints RPC ; les clés privées des portefeuilles ne sont jamais lisibles ni modifiables par un agent, quel que soit le niveau
    .placeholder = allow
config-agent-control-enabled = Activer le contrôle par agent
    .hint = Active le pont d'agent local authentifié et l'adaptateur MCP stdio. Les clients non appairés ne reçoivent aucun outil
config-agent-control-portfolio = Outils de portefeuille
    .hint = Niveau d'autorisation des outils de portefeuille (allow, ask_user, deny)
    .placeholder = allow
config-agent-control-system = Outils système
    .hint = Niveau d'autorisation des outils système (allow, ask_user, deny)
    .placeholder = allow
config-agent-control-trading = Outils de trading
    .hint = Niveau d'autorisation des outils de trading (allow, ask_user, deny) pour l'assistant intégré et les automatisations planifiées. Les connexions d'agents appairés ont leur propre politique, définie par connexion dans Paramètres -> Connexions d'agents
    .placeholder = allow

## assistant

config-assistant-auto-summarize = Résumé automatique
    .hint = Résume et compresse automatiquement les longues conversations pour économiser du contexte
config-assistant-check-interval-seconds = Intervalle de vérification
    .hint = Fréquence à laquelle le planificateur recherche les tâches à exécuter
    .unit = s
config-assistant-default-timeout-seconds = Délai d'expiration par défaut
    .hint = Durée maximale d'exécution d'une tâche planifiée avant son arrêt
    .unit = s
config-assistant-enabled = Activer l'assistant
    .hint = Active l'interface de chat de l'assistant pour les conversations interactives
config-assistant-event-triggers-enabled = Déclencheurs d'événements
    .hint = Autorise l'assistant à déclencher des actions selon des événements (désactivé par défaut par sécurité)
config-assistant-max-concurrent = Tâches simultanées max.
    .hint = Nombre maximal de tâches planifiées pouvant s'exécuter en même temps
config-assistant-max-session-messages = Messages max. par session
    .hint = Nombre maximal de messages par session de chat avant le résumé automatique
    .unit = msg
config-assistant-scheduled-tasks-enabled = Tâches planifiées
    .hint = Active les tâches automatisées de l'assistant exécutées selon un calendrier

