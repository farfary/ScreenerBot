## Glossary (French)
# Position = Position (f)
# Open position = Position ouverte (f)
# Close / closed position = Clôturer / position clôturée (f)
# Entry = Entrée (f)
# Exit = Sortie (f)
# Partial exit = Sortie partielle (f)
# Take profit = Take profit (m)
# Stop loss = Stop loss (m)
# Trailing stop = Trailing stop (m)
# DCA (dollar-cost averaging) = DCA (m), investissement programmé
# Slippage = Slippage (m)
# Priority fee = Frais de priorité (m pl)
# Pool = Pool (m)
# Liquidity = Liquidité (f)
# Market cap = Capitalisation (f)
# Volume = Volume (m)
# Holder = Holder (m)
# Token = Token (m)
# Mint address = Adresse de mint (f)
# Wallet = Portefeuille (m)
# Main wallet = Portefeuille principal (m)
# Swap = Swap (m)
# Buy = Achat (m) / Acheter
# Sell = Vente (f) / Vendre
# Filter = Filtre (m)
# Filtering = Filtrage (m)
# Strategy = Stratégie (f)
# Condition = Condition (f)
# Signal = Signal (m)
# Paper trading = Trading simulé (m)
# Copy trading = Copy trading (m)
# Copy task = Tâche de copie (f)
# Watchlist = Liste de suivi (f)
# Blacklist = Liste noire (f)
# Whitelist = Liste blanche (f)
# Profit and loss (P&L) = Profits et pertes (m pl), P&L (m)
# Unrealized = Latent (m)
# Realized = Réalisé (m)
# Balance = Solde (m)
# Dashboard = Tableau de bord (m)
# Settings = Paramètres (m pl)
# Trader (the automated trading engine) = Trader (m)
# Force stop = Arrêt forcé (m)
# Loss limit = Limite de perte (f)
# Candle = Bougie (f)
# Chart = Graphique (m)
# Transaction = Transaction (f)
# Signature = Signature (f)
# Rug pull = Rug pull (m)
# Security score = Score de sécurité (m)
# Airdrop = Airdrop (m)
# Assistant (the AI assistant) = Assistant (m)
# Provider (LLM or RPC provider) = Fournisseur (m)
# Endpoint = endpoint (m)
# Scheduled task = Tâche planifiée (f)
# Notification = Notification (f)
# Explore Mode = Mode Explorer (m)
# Backfill = Rattrapage (m)
# Holding (tokens held) = Détention (f)
# Round (copy round) = Cycle (m)
# Arm live = Armer le mode réel
# Kill switch = Kill switch (m)
# Authority (mint/freeze) = Autorité (f)
# Sub-wallet = Sous-portefeuille (m)
# Secondary wallet = Portefeuille secondaire (m)
# Instruction (assistant) = Consigne (f)
# Instruction (on-chain) = Instruction (f)
# Model (LLM) = Modèle (m)
# Confidence = Confiance (f)
# Latency = Latence (f)
# Boost / boosted = Boost (m) / boosté
# Featured = À la une
# Rent (token account) = Rent (m)
# Burn = Burn (m) / brûler
# Reclaim = Récupérer
# Passed / rejected (filter) = Validé / rejeté
# Average (short) = Moy.
# Add (DCA add to a position) = Renfort (m)
# Cooldown = Délai de récupération (m)
# Core (backend binary) = Noyau (m)
# System tray = Zone de notification (f)
# Win rate = Taux de réussite (m)
# Time units = j (jour) / h (heure) / min (minute) / s (seconde)
# ATA = ATA (m)
# Multi-buy / multi-sell = Multi-achat (m) / Multi-vente (f)
# Vanity address = Adresse personnalisée (f)
# Keypair = Paire de clés (f)
# Honeypot = Honeypot (m)
# Trade = Trade (m)
# Router = Routeur (m)
# Quote (swap) = Cotation (f)
# Poll = Interrogation (f)
# Uptime = Disponibilité (f)
# Insiders = Initiés (m pl)
# Whale = Baleine (f)
# Emergency stop = Arrêt d'urgence (m)
# Snapshot = Instantané (m)
# Gap (candle gap) = Lacune (f)
# Breakout = Cassure (f)
# Wick = Mèche (f)
# Payload = Charge utile (f)
# Severity = Gravité (f)
# Cost basis = Prix de revient (m)
# Log = Journal (m), pl. Journaux
# Watch (wallet watch) = Suivi (m)
# Preview = Aperçu (m)

