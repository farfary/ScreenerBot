account-data-access-ready = { -brand } डेटा सक्रिय है
    .detail = साझा कैंडल, पूल रजिस्ट्री, सिक्योरिटी रिपोर्ट और टोकन पहचान screenerbot.io से दिए जा रहे हैं।

account-data-access-disabled = { -brand } डेटा बंद है
    .detail = आपकी सेटिंग्स में { -brand } स्रोत बंद है, इसलिए डेटा केवल सार्वजनिक प्रोवाइडर से आता है।

account-data-access-offline = { -brand } डेटा ऑफ़लाइन है
    .detail = नेटवर्क कनेक्शन नहीं है। कनेक्शन लौटते ही डेटा अपने आप फिर से शुरू हो जाएगा।

account-data-access-signed-out = { -brand } डेटा के लिए अकाउंट चाहिए
    .detail = चार्ट, पूल, सिक्योरिटी रिपोर्ट और टोकन पहचान इसके बजाय सार्वजनिक प्रोवाइडर से आते हैं। वे धीमे हैं, उन पर रेट लिमिट है और इतिहास कम मिलता है। साइन इन करना मुफ़्त है और इससे { -brand } के बाकी कामकाज में कोई बदलाव नहीं होता।

account-data-access-reauthorization-required = { -brand } डेटा के लिए दोबारा साइन इन करना ज़रूरी है
    .detail = इस डिवाइस को { -brand } डेटा शुरू होने से पहले अधिकृत किया गया था। इसे बहाल करने के लिए दोबारा साइन इन करें — तब तक सार्वजनिक प्रोवाइडर उपयोग हो रहे हैं।

account-data-access-version-unsupported = { -brand } डेटा के लिए नया वर्शन चाहिए
    .detail = यह वर्शन अब सर्व नहीं किया जाता। { -brand } डेटा फिर से उपयोग करने के लिए { $minimum } या नए वर्शन पर अपडेट करें; तब तक सार्वजनिक प्रोवाइडर उपयोग हो रहे हैं।

account-data-access-unreachable = { -brand } डेटा जवाब नहीं दे रहा
    .detail = सर्विस ने जवाब नहीं दिया। सार्वजनिक प्रोवाइडर उपयोग हो रहे हैं और { -brand } दोबारा प्रयास करता रहेगा।

account-data-access-unknown = { -brand } डेटा की अभी जाँच नहीं हुई है
    .detail = इस सेशन में { -brand } को अभी तक साझा डेटा की ज़रूरत नहीं पड़ी।

account-scope-data-read = { -brand } मार्केट डेटा
account-scope-rpc-submit = साइन किए गए ट्रांज़ैक्शन का मुफ़्त सबमिशन
account-scope-vote = टोकन वोटिंग
account-scope-referral-read = रेफ़रल कमाई
account-scope-account-read = अकाउंट विवरण

