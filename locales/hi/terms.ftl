## Glossary (Hindi)
# Position = पोज़िशन (f)
# Open position = खुली पोज़िशन (f)
# Close / closed position = बंद पोज़िशन (f); बंद करें
# Entry = एंट्री (f)
# Exit = एग्ज़िट (m)
# Partial exit = आंशिक एग्ज़िट (m)
# Take profit = टेक प्रॉफ़िट (m)
# Stop loss = स्टॉप लॉस (m)
# Trailing stop = ट्रेलिंग स्टॉप (m)
# DCA (dollar-cost averaging) = DCA (m)
# Slippage = स्लिपेज (m)
# Priority fee = प्रायोरिटी फ़ीस (f)
# Pool = पूल (m)
# Liquidity = लिक्विडिटी (f)
# Market cap = मार्केट कैप (m)
# Volume = वॉल्यूम (m)
# Holder = होल्डर (m)
# Token = टोकन (m)
# Mint address = मिंट एड्रेस (m)
# Wallet = वॉलेट (m)
# Main wallet = मुख्य वॉलेट (m)
# Swap = स्वैप (m)
# Buy = खरीदें (verb) / खरीद (f)
# Sell = बेचें (verb) / बिक्री (f)
# Filter = फ़िल्टर (m)
# Filtering = फ़िल्टरिंग (f)
# Strategy = स्ट्रैटेजी (f)
# Condition = शर्त (f)
# Signal = सिग्नल (m)
# Paper trading = पेपर ट्रेडिंग (f)
# Copy trading = कॉपी ट्रेडिंग (f)
# Copy task = कॉपी टास्क (m)
# Watchlist = वॉचलिस्ट (f)
# Blacklist = ब्लैकलिस्ट (f)
# Whitelist = व्हाइटलिस्ट (f)
# Profit and loss (P&L) = लाभ-हानि (P&L) (f)
# Unrealized = अवास्तविक
# Realized = वास्तविक
# Balance = बैलेंस (m)
# Dashboard = डैशबोर्ड (m)
# Settings = सेटिंग्स (f)
# Trader (the automated trading engine) = ट्रेडर (m)
# Force stop = ज़बरन रोक (f)
# Loss limit = लॉस लिमिट (f)
# Candle = कैंडल (f)
# Chart = चार्ट (m)
# Transaction = ट्रांज़ैक्शन (m)
# Signature = सिग्नेचर (m)
# Rug pull = रग पुल (m)
# Security score = सिक्योरिटी स्कोर (m)
# Airdrop = एयरड्रॉप (m)
# Assistant (the AI assistant) = असिस्टेंट (m)
# Provider (LLM or RPC provider) = प्रोवाइडर (m)
# Endpoint = एंडपॉइंट (m)
# Scheduled task = शेड्यूल्ड टास्क (m)
# Notification = नोटिफ़िकेशन (m)
# Explore Mode = एक्सप्लोर मोड (m)
# Backfill = बैकफ़िल (m)
# Holding (tokens held) = होल्डिंग (f)
# Round (copy round) = राउंड (m)
# Arm live = लाइव सक्रिय करें
# Kill switch = किल स्विच (m)
# Authority (mint/freeze) = अथॉरिटी (f)
# Sub-wallet = सब-वॉलेट (m)
# Secondary wallet = सेकेंडरी वॉलेट (m)
# Instruction (assistant) = निर्देश (m)
# Instruction (on-chain) = इंस्ट्रक्शन (m)
# Model (LLM) = मॉडल (m)
# Confidence = कॉन्फ़िडेंस (m)
# Latency = लेटेंसी (f)
# Boost / boosted = बूस्ट (m) / बूस्टेड
# Featured = फ़ीचर्ड
# Rent (token account) = रेंट (m)
# Burn = बर्न (m)
# Reclaim = वापस पाना / रिक्लेम (m)
# Passed / rejected (filter) = पास / अस्वीकृत
# Average (short) = औसत
# Add (DCA add to a position) = ऐड (m)
# Cooldown = कूलडाउन (m)
# Core (backend binary) = कोर (m)
# System tray = सिस्टम ट्रे (f)
# Win rate = विन रेट (m)
# Time unit abbreviations for day / hour / minute / second = दिन / घंटा / मिनट / सेकंड (written as words after a space)
# Snapshot = स्नैपशॉट (m)
# Gap (candle gap) = गैप (m)
# Breakout = ब्रेकआउट (m)
# Wick = विक (f)
# Payload = पेलोड (m)
# Severity = गंभीरता (f)
# Cost basis = कॉस्ट बेसिस (m)
# Log = लॉग (m)
# Watch (wallet watch) = वॉच (m)
# Preview = प्रीव्यू (m)
# Multi-buy / multi-sell = मल्टी-बाय / मल्टी-सेल (m)
# Vanity address = वैनिटी एड्रेस (m)
# Keypair = कीपेयर (m)
# Honeypot = हनीपॉट (m)
# Trade (noun) = ट्रेड (m)
# Router = राउटर (m)
# Quote (swap quote) = कोट (m)
# Poll (noun) = पोल (m)
# Uptime = अपटाइम (m)
# Insiders = इनसाइडर्स (m)
# Whale = व्हेल (m)
# Emergency stop = इमरजेंसी स्टॉप (m)
# Profit factor = प्रॉफ़िट फ़ैक्टर (m)
# Drawdown = ड्रॉडाउन (m)
# Hold time = होल्ड टाइम (m)
# Timeframe = टाइमफ़्रेम (m)
# Moving average = मूविंग एवरेज (m)
# Compute units = कंप्यूट यूनिट्स (f)
# Lookback = लुकबैक (m)
# Explorer (block explorer) = एक्सप्लोरर (m)
# Consolidation = कंसॉलिडेशन (m)
# Top up = टॉप अप (m)
# Trade Watcher = ट्रेड वॉचर (m)
# Holder Watch = होल्डर वॉच (m)
# Prompt (LLM) = प्रॉम्प्ट (m)
# Amount = राशि (f)
# Deployer = डिप्लॉयर (m)
# ON / OFF = चालू / बंद

