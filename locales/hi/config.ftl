    .hint = ऑटो-ब्लैकलिस्ट करने से पहले टोकन के स्कैम होने का न्यूनतम कॉन्फ़िडेंस (0-100%)। ज़्यादा = कम गलत पहचान
    .unit = %
config-llm-analysis-background-batch-size = बैकग्राउंड बैच साइज़
    .hint = हर बैकग्राउंड बैच में कितनी पोज़िशन जाँची जाएँ
config-llm-analysis-background-check-enabled = बैकग्राउंड जाँच
    .hint = खुली पोज़िशन का बैकग्राउंड में समय-समय पर दोबारा मूल्यांकन करें
config-llm-analysis-background-check-interval-seconds = बैकग्राउंड जाँच अंतराल
    .hint = खुली पोज़िशन की दोबारा जाँच कितनी बार हो
    .unit = सेकंड
config-llm-analysis-cache-ttl-seconds = कैश TTL
    .hint = दोबारा मूल्यांकन से पहले विश्लेषण परिणाम कितनी देर कैश रहें
    .unit = सेकंड
config-llm-analysis-entry-analysis-enabled = एंट्री विश्लेषण
    .hint = पोज़िशन खोलने से पहले टोकन का विश्लेषण करें
config-llm-analysis-exit-analysis-enabled = एग्ज़िट विश्लेषण
    .hint = पोज़िशन से कब निकलना है, यह तय करने में विश्लेषण की मदद लें
config-llm-analysis-fallback-pass = विफलता पर फ़ॉलबैक पास
    .hint = true हो तो विश्लेषण विफल/त्रुटिपूर्ण होने पर टोकन फ़िल्टरिंग पास कर लेते हैं। false हो तो विश्लेषण उपलब्ध न होने पर टोकन फ़ेल होते हैं
config-llm-analysis-filtering-enabled = फ़िल्टरिंग विश्लेषण
    .hint = फ़िल्टरिंग के दौरान मेटाडेटा, सोशल सिग्नल और जोखिम कारकों पर टोकन को स्कोर करने के लिए मॉडल विश्लेषण का उपयोग करें
config-llm-analysis-max-evaluations-per-minute = अधिकतम मूल्यांकन/मिनट
    .hint = सभी सुविधाओं में विश्लेषण मूल्यांकन की ग्लोबल रेट लिमिट
    .unit = अनुरोध/मिनट
config-llm-analysis-min-confidence = न्यूनतम कॉन्फ़िडेंस
    .hint = फ़िल्टरिंग पास करने के लिए न्यूनतम कॉन्फ़िडेंस स्कोर (0-100%)। ज़्यादा = सख़्त
    .unit = %
config-llm-analysis-trading-bypass-cache = ट्रेडिंग में कैश बायपास
    .hint = ट्रेडिंग निर्णयों के लिए हमेशा ताज़ा विश्लेषण लें (सटीकता के लिए अनुशंसित)
config-llm-analysis-trailing-stop-enabled = डायनामिक ट्रेलिंग स्टॉप
    .hint = बाज़ार की स्थितियों के विश्लेषण के आधार पर ट्रेलिंग स्टॉप स्तर गतिशील रूप से बदलें
config-llm-analysis-use-cache = फ़िल्टरिंग परिणाम कैश करें
    .hint = API कॉल और लागत घटाने के लिए फ़िल्टरिंग मूल्यांकन कैश करें

config-maintenance-actions-retention-days = एक्शन रिटेंशन
    .hint = एक्शन हिस्ट्री कितने दिन रखी जाए (0 = हमेशा रखें)
    .unit = दिन
config-maintenance-events-retention-days = इवेंट रिटेंशन
    .hint = इवेंट हिस्ट्री कितने दिन रखी जाए (0 = हमेशा रखें)
    .unit = दिन
config-maintenance-maintenance-window-start = मेंटेनेंस विंडो शुरू
    .hint = भारी मेंटेनेंस का शुरुआती समय (HH:MM स्थानीय समय)। खाली = कभी भी।
config-maintenance-ohlcv-retention-days = OHLCV रिटेंशन
    .hint = OHLCV कैंडल डेटा कितने दिन रखा जाए (0 = हमेशा रखें)
    .unit = दिन
config-maintenance-rpc-stats-retention-hours = RPC आँकड़े रिटेंशन
    .hint = RPC आँकड़े कितने घंटे रखे जाएँ (0 = हमेशा रखें)
    .unit = घंटे
config-maintenance-skip-during-active-trades = सक्रिय ट्रेड के दौरान छोड़ें
    .hint = पोज़िशन खुली होने पर भारी मेंटेनेंस (VACUUM) टालें
config-maintenance-stale-token-days = पुराने टोकन की कटऑफ़
    .hint = जिन टोकन का मार्केट डेटा इससे ज़्यादा समय से अपडेट नहीं हुआ, उन्हें मेमोरी बचाने के लिए फ़िल्टरिंग से बाहर रखा जाता है। 0 = सभी शामिल। 7 दिन पर टोकन संख्या आमतौर पर ~90% घट जाती है।
    .unit = दिन
config-maintenance-vacuum-interval-secs = VACUUM अंतराल
    .hint = SQLite VACUUM कितनी बार चले (डिस्क स्पेस वापस पाता है, भारी ऑपरेशन)
    .unit = सेकंड
config-maintenance-wal-checkpoint-interval-secs = WAL चेकपॉइंट अंतराल
    .hint = SQLite WAL चेकपॉइंट कितनी बार चले (write-ahead log को समेकित करता है)
    .unit = सेकंड

config-network-proxy = प्रॉक्सी URL
    .hint = जैसे socks5://127.0.0.1:1080 या http://127.0.0.1:8080 — अपने आप पहचान के लिए खाली छोड़ें
    .placeholder = socks5://127.0.0.1:1080

config-ohlcv-auto-fill-gaps = गैप अपने आप लाएँ
    .hint = गैप मिलने पर छूटी हुई कैंडल अपने आप लाएँ
config-ohlcv-cache-retention-hours = कैश रिटेंशन
    .hint = टोकन को हॉट कैश में कितने घंटे रखा जाए
    .unit = घंटे
config-ohlcv-cache-size = कैश अधिकतम टोकन
