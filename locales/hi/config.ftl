config-ohlcv-enabled = चालू
    .hint = टेक्निकल विश्लेषण के लिए OHLCV कैंडलस्टिक डेटा संग्रह चालू करें
config-ohlcv-max-empty-fetches = खाली प्रतिक्रिया सीमा
    .hint = अनुरोधों को धीमा करने से पहले लगातार खाली API प्रतिक्रियाएँ
config-ohlcv-max-monitored-tokens = अधिकतम मॉनिटर किए गए टोकन
    .hint = जितने टोकन का OHLCV डेटा ट्रैक किया जाए, उनकी अधिकतम संख्या (ज़्यादा होने पर मेमोरी/डिस्क ज़्यादा लगती है; भारी फ़ेचिंग साझा डेटा सर्वर करता है, इसलिए इसे उदार रख सकते हैं)
    .unit = टोकन
config-ohlcv-max-pool-failures = फ़ॉलबैक सीमा
    .hint = बैकअप स्रोत पर जाने से पहले लगातार विफलताएँ
config-ohlcv-pool-failover-enabled = फ़ॉलबैक चालू करें
    .hint = प्राथमिक स्रोत विफल होने पर वैकल्पिक डेटा स्रोत पर जाएँ
config-ohlcv-retention-days = रिटेंशन दिन
    .hint = ऐतिहासिक OHLCV डेटा कितने दिन रखा जाए
    .unit = दिन
config-ohlcv-sources = डेटा स्रोत
