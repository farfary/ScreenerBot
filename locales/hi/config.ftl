    .hint = हेडलेस मोड में डैशबोर्ड तक पहुँचने के लिए पासवर्ड ज़रूरी करें। पासवर्ड CLI या API से सेट करें।
config-webserver-auth-session-timeout-secs = सेशन टाइमआउट
    .hint = सेशन कितनी देर बाद समाप्त होकर दोबारा लॉगिन माँगे। 0 = कभी समाप्त नहीं।
config-webserver-auth-show-logo = लोगो दिखाएँ
    .hint = लॉगिन पेज पर { -brand } लोगो दिखाएँ।
config-webserver-auth-show-name = ऐप का नाम दिखाएँ
    .hint = लॉगिन पेज पर '{ -brand }' दिखाएँ।
config-webserver-auth-totp-enabled = 2FA (TOTP) चालू करें
    .hint = पासवर्ड के साथ TOTP कोड भी ज़रूरी करें। डैशबोर्ड सेटिंग्स से सेट करें।
config-webserver-host = होस्ट
    .hint = बाइंड करने का IP: 127.0.0.1 = केवल लोकलहोस्ट, 0.0.0.0 = सभी इंटरफ़ेस (VPS/रिमोट; ऑथेंटिकेशन ज़रूरी)। रीस्टार्ट ज़रूरी।
    .placeholder = 127.0.0.1
config-webserver-port = पोर्ट
    .hint = डैशबोर्ड एक्सेस के लिए पोर्ट (केवल हेडलेस मोड)। प्रभावी होने के लिए रीस्टार्ट ज़रूरी।

