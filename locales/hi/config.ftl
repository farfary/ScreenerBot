# Configuration field labels. Generated once from the schema metadata; edited here from now on.

config-account-auto-wallet-signin = मेरे वॉलेट से अपने आप साइन इन करें
    .hint = यदि इस वॉलेट का { -brand } अकाउंट पहले से है, तो स्टार्टअप पर बिना पूछे साइन इन करें। डिफ़ॉल्ट रूप से बंद: अपनी ट्रेडिंग की से संदेश साइन करना ऐसी चीज़ है जिसे आपको चुनना चाहिए, बॉट को तय नहीं करना चाहिए।
config-account-refresh-margin-secs = टोकन रीफ़्रेश मार्जिन (सेकंड)
    .hint = साइन-इन टोकन की समाप्ति से कितने पहले उसे नवीनीकृत किया जाए। इसे केवल तभी बदलें जब आप ऑथेंटिकेशन डीबग कर रहे हों।
config-account-use-gateway-rpc = ट्रांज़ैक्शन भेजने के लिए { -brand } RPC का उपयोग करें
    .hint = साइन किए गए स्वैप ट्रांज़ैक्शन अपने RPC के बजाय screenerbot.io के ज़रिए ब्रॉडकास्ट करें। साइनिंग हमेशा इसी मशीन पर होती है; सर्वर साइन किए गए ट्रांज़ैक्शन को बदल नहीं सकता। प्राइस डेटा के लिए आपका अपना RPC फिर भी ज़रूरी है।

config-agent-control-analysis = विश्लेषण टूल्स
    .hint = विश्लेषण टूल्स के लिए अनुमति स्तर (allow, ask_user, deny)
    .placeholder = allow
config-agent-control-config = कॉन्फ़िग टूल्स
    .hint = कॉन्फ़िगरेशन टूल्स के लिए अनुमति स्तर (allow, ask_user, deny)। RPC एंडपॉइंट सहित ऐप की हर सेटिंग पहुँच में है; वॉलेट की प्राइवेट की सामग्री किसी भी स्तर पर एजेंट के लिए न पढ़ने योग्य है, न लिखने योग्य
    .placeholder = allow
config-agent-control-enabled = एजेंट कंट्रोल चालू करें
    .hint = प्रमाणित लूपबैक एजेंट ब्रिज और stdio MCP एडेप्टर चालू करें। अनपेयर्ड क्लाइंट को कोई टूल नहीं मिलता
config-agent-control-portfolio = पोर्टफ़ोलियो टूल्स
    .hint = पोर्टफ़ोलियो टूल्स के लिए अनुमति स्तर (allow, ask_user, deny)
    .placeholder = allow
config-agent-control-system = सिस्टम टूल्स
    .hint = सिस्टम टूल्स के लिए अनुमति स्तर (allow, ask_user, deny)
    .placeholder = allow
config-agent-control-trading = ट्रेडिंग टूल्स
    .hint = ऐप के असिस्टेंट और शेड्यूल्ड ऑटोमेशन के लिए ट्रेडिंग टूल्स का अनुमति स्तर (allow, ask_user, deny)। पेयर्ड एजेंट कनेक्शन की अपनी नीति होती है, जो सेटिंग्स -> एजेंट कनेक्शन में हर कनेक्शन के लिए तय होती है
    .placeholder = allow

config-assistant-auto-summarize = ऑटो सारांश
    .hint = संदर्भ बचाने के लिए लंबी बातचीत का अपने आप सारांश बनाएँ और उसे संक्षिप्त करें
config-assistant-check-interval-seconds = जाँच अंतराल
