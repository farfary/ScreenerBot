desktop-shortcuts-title = कीबोर्ड शॉर्टकट
desktop-shortcuts-message = { -brand } कीबोर्ड शॉर्टकट
desktop-shortcuts-body-mac =
    कीबोर्ड शॉर्टकट:

    विंडो नियंत्रण:
      Cmd+M          मिनिमाइज़
      Cmd+W          विंडो बंद करें
      Cmd+Q          बाहर निकलें
      Cmd+Ctrl+F     फ़ुलस्क्रीन टॉगल करें

    ज़ूम:
      Cmd++          ज़ूम इन
      Cmd+-          ज़ूम आउट
      Cmd+0          ज़ूम रीसेट

    नेविगेशन:
      Cmd+R          डैशबोर्ड रीलोड करें
      Cmd+Shift+D    डेटा फ़ोल्डर खोलें

    अन्य:
      F1             दस्तावेज़ीकरण खोलें
      Cmd+Alt+I      DevTools टॉगल करें
desktop-shortcuts-body-other =
    कीबोर्ड शॉर्टकट:

    विंडो नियंत्रण:
      Alt+F4         बाहर निकलें
      F11            फ़ुलस्क्रीन टॉगल करें

    ज़ूम:
      Ctrl++         ज़ूम इन
      Ctrl+-         ज़ूम आउट
      Ctrl+0         ज़ूम रीसेट

    नेविगेशन:
      Ctrl+R         डैशबोर्ड रीलोड करें
      Ctrl+Shift+D   डेटा फ़ोल्डर खोलें

    अन्य:
      F1             दस्तावेज़ीकरण खोलें
      Ctrl+Shift+I   DevTools टॉगल करें

