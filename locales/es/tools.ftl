tools-consolidation-selection-totals =
    | { $amount } | { $tokens ->
        [one] { $tokens } token
        [many] { $tokens } tokens
       *[other] { $tokens } tokens
    } | { $atas ->
        [one] { $atas } ATA vacía
        [many] { $atas } ATA vacías
       *[other] { $atas } ATA vacías
    }
tools-consolidation-transferred-native = { $amount } transferidos a la billetera principal
tools-consolidation-transferred-tokens =
    { $count ->
        [one] Se transfirió { $count } token a la billetera principal
        [many] Se transfirieron { $count } tokens a la billetera principal
       *[other] Se transfirieron { $count } tokens a la billetera principal
    }
tools-consolidation-cleaned =
    { $count ->
        [one] Se cerró { $count } ATA y se recuperaron { $amount }
        [many] Se cerraron { $count } ATA y se recuperaron { $amount }
       *[other] Se cerraron { $count } ATA y se recuperaron { $amount }
    }

