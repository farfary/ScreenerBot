## Glossary (Simplified Chinese)
# Position = 仓位
# Open position = 持仓中的仓位
# Close / closed position = 平仓 / 已平仓
# Entry = 入场
# Exit = 出场
# Partial exit = 部分出场
# Take profit = 止盈
# Stop loss = 止损
# Trailing stop = 追踪止损
# DCA (dollar-cost averaging) = DCA（定投加仓）
# Slippage = 滑点
# Priority fee = 优先费
# Pool = 流动性池
# Liquidity = 流动性
# Market cap = 市值
# Volume = 成交量
# Holder = 持有者
# Token = 代币
# Mint address = 铸造地址
# Wallet = 钱包
# Main wallet = 主钱包
# Swap = 兑换
# Buy = 买入
# Sell = 卖出
# Filter = 过滤器
# Filtering = 过滤
# Strategy = 策略
# Condition = 条件
# Signal = 信号
# Paper trading = 模拟交易
# Copy trading = 跟单交易
# Copy task = 跟单任务
# Watchlist = 关注列表
# Blacklist = 黑名单
# Whitelist = 白名单
# Profit and loss (P&L) = 盈亏
# Unrealized = 未实现
# Realized = 已实现
# Balance = 余额
# Dashboard = 仪表盘
# Settings = 设置
# Trader (the automated trading engine) = 交易引擎
# Force stop = 强制停止
# Loss limit = 亏损限额
# Candle = K 线
# Chart = 图表
# Transaction = 交易
# Signature = 签名
# Rug pull = 跑路（Rug Pull）
# Security score = 安全评分
# Airdrop = 空投
# Assistant (the AI assistant) = 助手
# Provider (LLM or RPC provider) = 提供商
# Endpoint = 端点
# Scheduled task = 计划任务
# Notification = 通知
# Explore Mode = 探索模式
# Backfill = 回填
# Holding (tokens held) = 持仓
# Round (copy round) = 轮次
# Arm live = 启用实盘
# Kill switch = 紧急开关
# Authority (mint/freeze) = 权限
# Sub-wallet = 子钱包
# Secondary wallet = 副钱包
# Instruction (assistant) = 指令
# Instruction (on-chain) = 链上指令
# Model (LLM) = 模型
# Confidence = 置信度
# Latency = 延迟
# Boost / boosted = 加速 / 已加速
# Featured = 精选
# Rent (token account) = 租金
# Burn = 销毁
# Reclaim = 回收
# Passed / rejected (filter) = 通过 / 未通过
# Average (short) = 均价
# Add (DCA add to a position) = 加仓
# Cooldown = 冷却时间
# Core (backend binary) = 核心程序
# System tray = 系统托盘
# Win rate = 胜率
# Time unit abbreviations = 天 / 小时 / 分钟 / 秒
# Snapshot = 快照
# Gap (candle gap) = 缺口
# Breakout = 突破
# Wick = 影线
# Payload = 载荷
# Severity = 严重程度
# Cost basis = 成本
# Log = 日志
# Watch (wallet watch) = 监控
# Preview = 预览
# Multi-buy / multi-sell = 批量买入 / 批量卖出
# Vanity address = 靓号地址
# Keypair = 密钥对
# Honeypot = 蜜罐
# Trade (noun) = 交易
# Router = 路由
# Quote (swap quote) = 报价
# Poll (noun) = 轮询
# Uptime = 运行时长
# Insiders = 内部人
# Whale = 巨鲸
# Emergency stop = 紧急停止
# Profit factor = 盈利因子
# Drawdown = 回撤
# Hold time = 持仓时间
# Timeframe = 时间周期
# Moving average = 移动平均线
# Compute units = 计算单元
# Lookback = 回溯期
# Explorer (block explorer) = 区块浏览器
# Consolidation = 归集
# Top up = 充值
# Trade Watcher = 交易监控
# Holder Watch = 持有者监控
# Prompt (LLM) = 提示词
# Amount = 数量
# Deployer = 部署者
# ON / OFF = 已启用 / 已停用

