## account

config-account-auto-wallet-signin = 使用我的钱包自动登录
    .hint = 当此钱包已有 { -brand } 账户时，启动时无需询问直接登录。默认关闭：使用交易密钥签名消息应由您自行选择，而不是由机器人决定。
config-account-refresh-margin-secs = 令牌刷新提前量
    .hint = 在登录令牌过期前多久续期。仅在调试身份验证时更改。
    .unit = 秒
config-account-use-gateway-rpc = 使用 { -brand } RPC 发送交易
    .hint = 通过 screenerbot.io 而不是您自己的 RPC 广播已签名的兑换交易。签名始终在本机完成，服务器无法修改已签名的交易。价格数据仍需要您自己的 RPC。

## agent_control

config-agent-control-analysis = 分析工具
    .hint = 分析工具的权限级别（allow、ask_user、deny）
    .placeholder = allow
config-agent-control-config = 配置工具
    .hint = 配置工具的权限级别（allow、ask_user、deny）。应用的所有设置均可访问，包括 RPC 端点；任何级别下，智能体都无法读取或写入钱包私钥材料
    .placeholder = allow
config-agent-control-enabled = 启用智能体控制
    .hint = 启用经过验证的本地回环智能体桥接和 stdio MCP 适配器。未配对的客户端不会获得任何工具
config-agent-control-portfolio = 投资组合工具
    .hint = 投资组合工具的权限级别（allow、ask_user、deny）
    .placeholder = allow
config-agent-control-system = 系统工具
    .hint = 系统工具的权限级别（allow、ask_user、deny）
    .placeholder = allow
config-agent-control-trading = 交易工具
    .hint = 应用内助手和计划自动化所用交易工具的权限级别（allow、ask_user、deny）。已配对的智能体连接使用各自的策略，可在“设置 -> 智能体连接”中按连接设置
    .placeholder = allow

## assistant

config-assistant-auto-summarize = 自动摘要
    .hint = 自动对较长的对话进行摘要和压缩，以节省上下文
config-assistant-check-interval-seconds = 检查间隔
    .hint = 调度器检查需要运行的任务的频率
    .unit = 秒
config-assistant-default-timeout-seconds = 默认超时
    .hint = 计划任务在被停止前可运行的最长时间
    .unit = 秒
config-assistant-enabled = 启用助手
    .hint = 启用用于交互式对话的助手聊天界面
config-assistant-event-triggers-enabled = 事件触发
    .hint = 允许助手根据事件触发操作（出于安全考虑默认关闭）
config-assistant-max-concurrent = 最大并发任务数
    .hint = 可同时运行的计划任务最大数量
config-assistant-max-session-messages = 会话最大消息数
    .hint = 每个聊天会话在自动摘要前的最大消息数
    .unit = 条
config-assistant-scheduled-tasks-enabled = 计划任务
    .hint = 启用按计划运行的助手自动化任务

## chains

config-chain-enabled = 已启用
    .hint = 在本进程中运行此区块链。重启后生效。
config-chain-rpc = RPC
config-chain-rpc-circuit-breaker-enabled = 启用熔断器
    .hint = 启用熔断器模式，用于提供商故障切换
config-chain-rpc-circuit-breaker-failure-threshold = 失败阈值
    .hint = 连续失败多少次后打开熔断
    .unit = 次
config-chain-rpc-circuit-breaker-half-open-requests = 半开请求数
    .hint = 半开状态下的探测请求数量
    .unit = 个
config-chain-rpc-circuit-breaker-open-duration-secs = 打开时长
    .hint = 熔断保持打开的时长，之后测试是否恢复
    .unit = 秒
config-chain-rpc-circuit-breaker-success-threshold = 成功阈值
    .hint = 半开状态下需要多少次成功才能关闭熔断
    .unit = 次
config-chain-rpc-connection-timeout-secs = 连接超时
    .hint = 建立连接的超时时间
    .unit = 秒
config-chain-rpc-default-rate-limit = 默认速率限制
    .hint = 未知提供商的默认每秒请求数
    .unit = 次/秒
config-chain-rpc-helius-rate-limit = { -helius } 速率限制
    .hint = { -helius } 提供商的每秒请求数
    .unit = 次/秒
config-chain-rpc-max-retries = 最大重试次数
    .hint = 失败时的最大重试次数
    .unit = 次
config-chain-rpc-pool-connections-per-host = 每主机连接数
    .hint = 每个主机的 HTTP 连接池大小
    .unit = 个
config-chain-rpc-pool-idle-timeout-secs = 连接池空闲超时
    .hint = 连接池中空闲连接的超时时间
    .unit = 秒
config-chain-rpc-public-rate-limit = 公共节点速率限制
    .hint = 公共端点的每秒请求数
    .unit = 次/秒
config-chain-rpc-quicknode-rate-limit = { -quicknode } 速率限制
    .hint = { -quicknode } 提供商的每秒请求数
    .unit = 次/秒
config-chain-rpc-request-timeout-secs = 请求超时
    .hint = 单个 RPC 请求的超时时间
    .unit = 秒
config-chain-rpc-retry-base-delay-ms = 重试基础延迟
    .hint = 首次重试前的初始延迟（指数退避）
    .unit = ms
config-chain-rpc-retry-max-delay-ms = 重试最大延迟
    .hint = 两次重试之间的最大延迟
    .unit = ms
config-chain-rpc-selection-strategy = 选择策略
    .hint = 提供商选择策略：adaptive、round_robin、priority、latency
config-chain-rpc-stats-enabled = 启用统计
    .hint = 启用 RPC 统计数据采集
config-chain-rpc-triton-rate-limit = Triton 速率限制
    .hint = Triton 提供商的每秒请求数
    .unit = 次/秒
config-chain-rpc-urls = RPC URL
    .hint = 以逗号分隔的 RPC 端点（轮询）
    .placeholder = 每行输入一个值
config-chain-swaps = 兑换
config-chain-swaps-cost-guard = 成本防护
    .hint = 无论由哪个路由构建，只要兑换会把 SOL 花在钱包无法回收的账户上，就拒绝该兑换
config-chain-swaps-cost-guard-always-allow-below-lamports = 低于此值始终放行
    .hint = 额外成本小到可以忽略，与交易规模无关，因此正常的舍入误差和尘埃金额不会拦截兑换。
    .unit = lam
config-chain-swaps-cost-guard-enabled = 已启用
    .hint = 在发送前模拟每笔聚合器交易，并拒绝会把 SOL 滞留在钱包无法关闭的账户中的交易。关闭则意味着路由可能在无警告的情况下锁定租金。
config-chain-swaps-cost-guard-max-extra-cost-pct = 最大额外成本
    .hint = 交易额中可花在钱包永远无法收回的账户上的比例。收取一次性押金的交易场所，仅在交易规模大到足以抵消时才会被接受。
    .unit = %
config-chain-swaps-cost-guard-retry-excluding-venue = 排除该场所后重试
    .hint = 当某个交易场所被拒绝时，先排除该场所再向同一聚合器询价，然后再回退到其他路由。
config-chain-swaps-direct = 直连流动性池兑换
    .hint = 自行构建 DEX 指令，而不是通过聚合器路由
config-chain-swaps-direct-confirmation-timeout-secs = 确认超时
    .hint = 在报告结果未知之前，等待兑换确认的时长
    .unit = 秒
config-chain-swaps-direct-enabled = 已启用
    .hint = 与其他已启用的路由一同直接向流动性池报价，并选取扣除网络费后收益最高的一个。
config-chain-swaps-direct-max-price-impact-pct = 最大价格影响
    .hint = 拒绝使流动性池价格波动超过此值的直连报价 -- 超过此值时，拆分订单的聚合器是更安全的选择
    .unit = %
config-chain-swaps-direct-priority-fee-micro-lamports = 优先费
    .hint = 以 micro-lamports 计的计算单元价格。越高，在拥堵区块中上链越快。
    .unit = µlam/CU
config-chain-swaps-jupiter = { -jupiter }
    .hint = { -jupiter } 聚合器路由
config-chain-swaps-jupiter-api-key = API 密钥
    .hint = 可选。留空则使用 { -jupiter } 的免费端点（lite-api.jup.ag）。仅在遇到速率限制且需要更高吞吐量时，才添加来自 portal.jup.ag 的密钥（api.jup.ag）。不会影响兑换手续费或推荐分成。
config-chain-swaps-jupiter-dynamic-compute-unit-limit = 动态 CU 上限
    .hint = 让 { -jupiter } 通过模拟兑换来确定计算单元上限。优先费按上限收取，因此按需设定的上限成本更低。
config-chain-swaps-jupiter-enabled = 已启用
    .hint = { -jupiter } 可路由至所有主要 DEX。关闭后只剩直连流动性池和 { -raptor }，它们无法交易所有代币。
config-chain-swaps-jupiter-priority-fee-micro-lamports = 优先费
    .hint = 以 micro-lamports 计的计算单元价格，与直连流动性池和 { -raptor } 使用相同的模型。越高，在拥堵区块中上链越快。
    .unit = µlam/CU
config-chain-swaps-quote-deadline-ms = 报价截止时间
    .hint = 收到第一个有效报价后，其余路由的应答时限；超时后交易将不再等待它们。在此之前会等待每个路由。
    .unit = ms
config-chain-swaps-raptor = { -raptor }
    .hint = Solana Tracker 的聚合器，与其他路由同时报价
config-chain-swaps-raptor-enabled = 已启用
    .hint = 与其他已启用的路由一同向 { -raptor } 报价，并选取扣除网络费后收益最高的一个。
config-chain-swaps-raptor-max-hops = 最大跳数
    .hint = { -raptor } 可构建的最长路由。跳数越多，可能找到更好的价格，但消耗更多计算量。
config-chain-swaps-raptor-priority-fee-micro-lamports = 优先费
    .hint = 以 micro-lamports 计的计算单元价格。越高，在拥堵区块中上链越快。
    .unit = µlam/CU
config-chains-show-preview = 预览区块链
    .hint = 显示尚未正式上线的区块链。重启后生效。
config-chains-solana = Solana

## copy_trading

config-copy-trading-default-slippage-pct = 默认滑点
    .hint = 模拟及未来实盘跟单的默认滑点
    .unit = %
config-copy-trading-enabled = 钱包跟单
    .hint = 启用跟单任务处理
config-copy-trading-latency-kill-switch-enabled = 延迟紧急开关
    .hint = 当跟单任务近期从目标交易到被检测的延迟持续高于设定上限时暂停该任务
config-copy-trading-latency-window-size = 延迟样本窗口
    .hint = 延迟紧急开关所使用的近期观察次数
config-copy-trading-max-active-tasks = 最大活跃任务数
    .hint = 可同时启用的跟单任务最大数量；模拟和实盘任务都计入，因为每个任务都会监控其钱包
config-copy-trading-max-arrival-distance-ms = 最大到达延迟
    .hint = 当最近样本窗口内从目标交易到被检测的平均延迟超过此值时暂停
    .unit = ms
config-copy-trading-readiness-min-closed-rounds = 实盘就绪轮次
    .hint = 任务通过实盘就绪清单前所需的已平仓模拟轮次
config-copy-trading-require-filter-pass = 要求通过过滤
    .hint = 仅跟单被过滤流程接受的代币

