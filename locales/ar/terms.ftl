## Glossary (Arabic)
# Position = مركز (m)
# Open position = مركز مفتوح (m)
# Close / closed position = إغلاق / مركز مغلق (m)
# Entry = دخول (m)
# Exit = خروج (m)
# Partial exit = خروج جزئي (m)
# Take profit = جني الأرباح (m)
# Stop loss = وقف الخسارة (m)
# Trailing stop = وقف متحرك (m)
# DCA (dollar-cost averaging) = DCA (متوسط التكلفة) (m)
# Slippage = الانزلاق السعري (m)
# Priority fee = رسوم الأولوية (f)
# Pool = مجمع سيولة (m)
# Liquidity = السيولة (f)
# Market cap = القيمة السوقية (f)
# Volume = حجم التداول (m)
# Holder = حامل (m)
# Token = رمز (m)
# Mint address = عنوان الإصدار (m)
# Wallet = محفظة (f)
# Main wallet = المحفظة الرئيسية (f)
# Swap = مبادلة (f)
# Buy = شراء (m)
# Sell = بيع (m)
# Filter = مرشح (m)
# Filtering = الترشيح (m)
# Strategy = استراتيجية (f)
# Condition = شرط (m)
# Signal = إشارة (f)
# Paper trading = التداول التجريبي (m)
# Copy trading = نسخ التداول (m)
# Copy task = مهمة نسخ (f)
# Watchlist = قائمة المراقبة (f)
# Blacklist = القائمة السوداء (f)
# Whitelist = القائمة البيضاء (f)
# Profit and loss (P&L) = الأرباح والخسائر (P&L) (f)
# Unrealized = غير محقق (m)
# Realized = محقق (m)
# Balance = رصيد (m)
# Dashboard = لوحة التحكم (f)
# Settings = الإعدادات (f)
# Trader (the automated trading engine) = المتداول الآلي (m)
# Force stop = إيقاف قسري (m)
# Loss limit = حد الخسارة (m)
# Candle = شمعة (f)
# Chart = مخطط (m)
# Transaction = معاملة (f)
# Signature = توقيع (m)
# Rug pull = سحب السجادة (Rug Pull) (m)
# Security score = درجة الأمان (f)
# Airdrop = إيردروب (m)
# Assistant (the AI assistant) = المساعد (m)
# Provider (LLM or RPC provider) = مزوّد (m)
# Endpoint = نقطة اتصال (f)
# Scheduled task = مهمة مجدولة (f)
# Notification = إشعار (m)
# Explore Mode = وضع الاستكشاف (m)
# Backfill = ملء البيانات السابقة (m)
# Holding (tokens held) = حيازة (f)
# Round (copy round) = جولة (f)
# Arm live = تفعيل التداول الحي (m)
# Kill switch = مفتاح الإيقاف الطارئ (m)
# Authority (mint/freeze) = صلاحية (f)
# Sub-wallet = محفظة فرعية (f)
# Secondary wallet = محفظة ثانوية (f)
# Instruction (assistant) = تعليمات (f)
# Instruction (on-chain) = تعليمة (f)
# Model (LLM) = نموذج (m)
# Confidence = الثقة (f)
# Latency = زمن الاستجابة (m)
# Boost / boosted = تعزيز / معزَّز (m)
# Featured = مميّز (m)
# Rent (token account) = إيجار (m)
# Burn = حرق (m)
# Reclaim = استرداد (m)
# Passed / rejected (filter) = ناجح / مرفوض (m)
# Average (short) = متوسط (m)
# Add (DCA add to a position) = إضافة (f)
# Cooldown = فترة تهدئة (f)
# Core (backend binary) = النواة (f)
# System tray = علبة النظام (f)
# Win rate = نسبة الربح (f)
# Time unit abbreviations = ي (يوم) / س (ساعة) / د (دقيقة) / ث (ثانية)
# Snapshot = لقطة (f)
# Gap (candle gap) = فجوة (f)
# Breakout = اختراق (m)
# Wick = ظل الشمعة (m)
# Payload = حمولة (f)
# Severity = الخطورة (f)
# Cost basis = تكلفة الأساس (f)
# Log = سجل (m)
# Watch (wallet watch) = مراقبة (f)
# Preview = معاينة (f)
# Multi-buy / multi-sell = شراء متعدد / بيع متعدد (m)
# Vanity address = عنوان مخصص (m)
# Keypair = زوج مفاتيح (m)
# Honeypot = فخ العسل (Honeypot) (m)
# Trade (noun) = صفقة (f)
# Router = موجّه (m)
# Quote (swap quote) = عرض سعر (m)
# Poll (noun) = استعلام دوري (m)
# Uptime = مدة التشغيل (f)
# Insiders = المطّلعون (m)
# Whale = حوت (m)
# Emergency stop = إيقاف طارئ (m)
# Profit factor = عامل الربح (m)
# Drawdown = التراجع (m)
# Hold time = مدة الاحتفاظ (f)
# Timeframe = الإطار الزمني (m)
# Moving average = المتوسط المتحرك (m)
# Compute units = وحدات الحوسبة (f)
# Lookback = فترة الرجوع (f)
# Explorer (block explorer) = المستكشف (m)
# Consolidation = تجميع (m)
# Top up = تعبئة (f)
# Trade Watcher = مراقب الصفقات (m)
# Holder Watch = مراقبة الحاملين (f)
# Prompt (LLM) = موجّه نصي (m)
# Amount = مبلغ (m)
# Deployer = ناشر (m)
# ON / OFF = مفعّل / معطّل
