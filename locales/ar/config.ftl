## swaps

config-swaps-cost-guard = حارس التكلفة
    .hint = رفض المبادلة التي تنفق { -sol } على حسابات لا تستطيع المحفظة استردادها، أيًّا كان الموجّه الذي بناها
config-swaps-cost-guard-always-allow-below-lamports = السماح دائمًا دون
    .hint = تكلفة إضافية صغيرة بما يكفي لتجاهلها مهما كان حجم الصفقة، فلا يحجب التقريب العادي أو الغبار أي مبادلة.
    .unit = lamports
config-swaps-cost-guard-enabled = مفعّل
    .hint = محاكاة كل معاملة مجمّع قبل إرسالها ورفض المعاملة التي تحجز { -sol } في حساب لا تستطيع المحفظة إغلاقه. التعطيل يعني أن المسار قد يقفل إيجار الحساب دون تحذير.
config-swaps-cost-guard-max-extra-cost-pct = أقصى تكلفة إضافية
    .hint = حصة الصفقة التي يجوز إنفاقها على حسابات لن تستردها المحفظة أبدًا. المنصة التي تفرض وديعة لمرة واحدة تُقبل فقط عندما تكون الصفقة كبيرة بما يكفي لتبريرها.
    .unit = % من الصفقة
config-swaps-cost-guard-retry-excluding-venue = إعادة المحاولة دون المنصة
    .hint = عند رفض منصة، اطلب من المجمّع نفسه مجددًا مع استبعاد تلك المنصة قبل الانتقال إلى موجّه آخر.
config-swaps-direct = مبادلات المجمع المباشرة
    .hint = بناء تعليمة DEX بأنفسنا بدلًا من التوجيه عبر مجمّع
config-swaps-direct-confirmation-timeout-secs = مهلة التأكيد
    .hint = مدة الانتظار لتأكيد المبادلة قبل الإبلاغ عن نتيجة غير معروفة
    .unit = ثوانٍ
config-swaps-direct-enabled = مفعّل
    .hint = طلب عرض سعر من المجمع مباشرة إلى جانب الموجّهات الأخرى المفعّلة واختيار الأعلى عائدًا بعد رسوم الشبكة.
config-swaps-direct-max-price-impact-pct = أقصى تأثير على السعر
    .hint = رفض عرض السعر المباشر الذي يحرّك المجمع أكثر من هذا الحد -- المجمّع الذي يقسّم الأمر هو الخيار الأكثر أمانًا فوقه
    .unit = %
config-swaps-direct-priority-fee-micro-lamports = رسوم الأولوية
    .hint = سعر وحدة الحوسبة بالميكرو لامبورت. الأعلى يُنفَّذ أسرع في كتلة مزدحمة.
    .unit = micro-lamports/CU
config-swaps-jupiter = { -jupiter }
    .hint = موجّه المجمّع { -jupiter }
config-swaps-jupiter-api-key = مفتاح API
    .hint = اختياري. اتركه فارغًا لاستخدام نقطة اتصال { -jupiter } المجانية (lite-api.jup.ag). أضف مفتاحًا من portal.jup.ag فقط إذا بلغت حدود المعدل وتريد سعة أعلى (api.jup.ag). لا يؤثر على رسوم المبادلة ولا على حصة عائد الإحالة.
config-swaps-jupiter-default-swap-mode = وضع المبادلة الافتراضي
    .hint = ExactIn أو ExactOut
config-swaps-jupiter-dynamic-compute-unit-limit = حد وحدات الحوسبة الديناميكي
    .hint = دع { -jupiter } يحدد حد وحدات الحوسبة بمحاكاة المبادلة. تُحتسب رسوم الأولوية على الحد، لذا يكلّف الحد المضبوط أقل.
config-swaps-jupiter-enabled = مفعّل
    .hint = يوجّه { -jupiter } عبر كل منصات DEX الرئيسية. تعطيله يترك المجمع المباشر و{ -raptor } فقط، وهما لا يستطيعان تداول كل رمز.
config-swaps-jupiter-priority-fee-micro-lamports = رسوم الأولوية
    .hint = سعر وحدة الحوسبة بالميكرو لامبورت، وهو النموذج نفسه المستخدم في المجمع المباشر و{ -raptor }. الأعلى يُنفَّذ أسرع في كتلة مزدحمة.
    .unit = micro-lamports/CU
config-swaps-raptor = { -raptor }
    .hint = مجمّع Solana Tracker، يُطلب منه عرض سعر إلى جانب الموجّهات الأخرى
config-swaps-raptor-enabled = مفعّل
    .hint = طلب عرض سعر من { -raptor } إلى جانب الموجّهات الأخرى المفعّلة واختيار الأعلى عائدًا بعد رسوم الشبكة.
config-swaps-raptor-max-hops = أقصى عدد للقفزات
    .hint = أطول مسار يمكن لـ { -raptor } بناؤه. المزيد من القفزات قد يجد سعرًا أفضل لكنه يكلّف حوسبة أكثر.
config-swaps-raptor-priority-fee-micro-lamports = رسوم الأولوية
    .hint = سعر وحدة الحوسبة بالميكرو لامبورت. الأعلى يُنفَّذ أسرع في كتلة مزدحمة.
    .unit = micro-lamports/CU
config-swaps-slippage = الانزلاق السعري
    .hint = إعدادات تحمّل الانزلاق السعري
config-swaps-slippage-exit-loss-shortfall-pct = الانزلاق السعري عند الخروج بخسارة
    .hint = أعلى حتى للخروج من المراكز السيئة
    .unit = %
config-swaps-slippage-exit-profit-shortfall-pct = الانزلاق السعري عند الخروج بربح
    .hint = الأعلى يضمن نجاح عمليات الخروج
    .unit = %
config-swaps-slippage-exit-retry-steps-pct = خطوات إعادة محاولة الخروج
    .hint = قيم الانزلاق السعري لإعادة المحاولة مفصولة بفواصل
    .unit = %
    .placeholder = أدخل قيمة واحدة في كل سطر
config-swaps-slippage-quote-default-pct = الانزلاق السعري الافتراضي
    .hint = 1% ضيق، و3-5% للتقلب
    .unit = %

## telegram

config-telegram-bot-token = رمز البوت
    .hint = احصل عليه من @BotFather على { -telegram }: 1) ابحث عن @BotFather 2) أرسل /newbot 3) اتبع التعليمات 4) انسخ الرمز
    .placeholder = 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
config-telegram-chat-id = معرّف الدردشة
    .hint = معرّف دردشة { -telegram } للإشعارات. استخدم وضع الاكتشاف للعثور عليه تلقائيًا.
    .placeholder = 123456789
config-telegram-commands-enabled = تفعيل الأوامر
    .hint = السماح بالتحكم في البوت عبر أوامر { -telegram }: /status, /positions, /balance, /stop, /start
config-telegram-commands-require-2fa = الأوامر تتطلب 2FA
    .hint = عند التفعيل، تتطلب الجلسات المنتهية رمز TOTP لإعادة التفعيل. يستخدم المصادقة الثنائية نفسها لشاشة قفل لوحة التحكم.
config-telegram-enabled = تفعيل { -telegram }
    .hint = تفعيل تكامل بوت { -telegram } للإشعارات والأوامر
config-telegram-include-ai-reasoning = تضمين استدلال LLM
    .hint = عرض استدلال تحليل LLM في إشعارات فتح المراكز وإغلاقها
config-telegram-inline-actions-enabled = الإجراءات المضمّنة
    .hint = عرض أزرار الإجراءات (بيع، إغلاق، قائمة سوداء) في إشعارات المراكز
config-telegram-language = اللغة
    .hint = لغة رسائل { -telegram }. القيمة "app" تتبع لغة لوحة التحكم؛ وإلا فاستخدم رمز لغة مسجّلًا.
config-telegram-lockout-minutes = مدة الحظر
    .hint = الدقائق التي يُقفل فيها الوصول بعد محاولات مصادقة فاشلة كثيرة
    .unit = دقائق
config-telegram-max-failed-attempts = أقصى عدد للمحاولات الفاشلة
    .hint = عدد محاولات TOTP الخاطئة قبل الحظر المؤقت
config-telegram-notify-copy-paper = صفقات النسخ التجريبي
    .hint = الإشعار أيضًا عند عمليات التنفيذ والخروج التجريبية المحاكاة للنسخ (قد تكون متكررة)
config-telegram-notify-copy-trading = نسخ التداول
    .hint = الإشعار عند عمليات تنفيذ النسخ الحي وخروجه وفشل مبادلاته والإيقاف المؤقت التلقائي لمهام النسخ
config-telegram-notify-daily-summary = الملخص اليومي
    .hint = إرسال ملخص يومي لنشاط التداول والأرباح والخسائر
config-telegram-notify-dca-executed = تنفيذ DCA
    .hint = الإشعار عند تنفيذ عملية شراء DCA (متوسط التكلفة)
config-telegram-notify-filtering-alerts = تنبيهات الترشيح
    .hint = الإشعار عند اجتياز رموز جديدة معايير الترشيح الخاصة بك
config-telegram-notify-on-shutdown = إيقاف البوت
    .hint = إرسال إشعار عند توقف { -brand }
config-telegram-notify-on-startup = تشغيل البوت
    .hint = إرسال إشعار عند بدء { -brand }
config-telegram-notify-partial-exit = عمليات الخروج الجزئي
    .hint = الإشعار عند تنفيذ خروج جزئي (بيع نسبة)
config-telegram-notify-position-closed = إغلاق مركز
    .hint = الإشعار عند إغلاق مركز تداول (مع الأرباح والخسائر)
config-telegram-notify-position-opened = فتح مركز
    .hint = الإشعار عند فتح مركز تداول جديد
config-telegram-notify-system-errors = أخطاء النظام
    .hint = الإشعار بأخطاء النظام الحرجة التي تتطلب انتباهًا
config-telegram-notify-trade-alerts = تنبيهات الصفقات
    .hint = الإشعار عند اكتشاف صفقات كبيرة على الرموز المراقَبة
config-telegram-session-timeout-minutes = مهلة الجلسة
    .hint = دقائق الخمول قبل طلب المصادقة من جديد
    .unit = دقائق
config-telegram-significant-pnl-threshold = الأرباح والخسائر الكبيرة
    .hint = حد مبلغ { -sol } لإبراز الأرباح والخسائر الكبيرة في الإشعارات
    .unit = SOL
config-telegram-trade-alert-min-sol = أدنى تنبيه صفقة
    .hint = أدنى حجم صفقة بـ { -sol } لإطلاق إشعار تنبيه صفقة
    .unit = SOL

