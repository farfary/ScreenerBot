## account

config-account-auto-wallet-signin = تسجيل الدخول تلقائيًا بمحفظتي
    .hint = عندما يكون لهذه المحفظة حساب { -brand } بالفعل، سجّل الدخول دون سؤال عند بدء التشغيل. معطّل افتراضيًا: توقيع رسالة بمفتاح التداول الخاص بك أمر تختاره أنت، لا يقرره البوت.
config-account-refresh-margin-secs = هامش تجديد الرمز المميّز (ثوانٍ)
    .hint = مدى التبكير في تجديد رمز تسجيل الدخول قبل انتهاء صلاحيته. لا تغيّره إلا عند تصحيح أخطاء المصادقة.
config-account-use-gateway-rpc = استخدام RPC الخاص بـ { -brand } لإرسال المعاملات
    .hint = بث معاملات المبادلة الموقّعة عبر screenerbot.io بدلًا من RPC الخاص بك. يتم التوقيع دائمًا على هذا الجهاز، ولا يستطيع الخادم تعديل معاملة موقّعة. ما زلت بحاجة إلى RPC الخاص بك لبيانات الأسعار.

## agent_control

config-agent-control-analysis = أدوات التحليل
    .hint = مستوى الصلاحية لأدوات التحليل (allow, ask_user, deny)
    .placeholder = allow
config-agent-control-config = أدوات الإعدادات
    .hint = مستوى الصلاحية لأدوات الإعدادات (allow, ask_user, deny). كل إعداد في التطبيق متاح، بما فيه نقاط اتصال RPC؛ أما مفاتيح المحفظة الخاصة فلا يمكن للوكيل قراءتها أو كتابتها عند أي مستوى
    .placeholder = allow
config-agent-control-enabled = تفعيل التحكم بالوكلاء
    .hint = تفعيل جسر الوكلاء المحلي المصادَق ومحوّل MCP عبر stdio. العملاء غير المقترنين لا يحصلون على أي أدوات
config-agent-control-portfolio = أدوات المحفظة
    .hint = مستوى الصلاحية لأدوات المحفظة (allow, ask_user, deny)
    .placeholder = allow
config-agent-control-system = أدوات النظام
    .hint = مستوى الصلاحية لأدوات النظام (allow, ask_user, deny)
    .placeholder = allow
config-agent-control-trading = أدوات التداول
    .hint = مستوى الصلاحية لأدوات التداول (allow, ask_user, deny) للمساعد داخل التطبيق والأتمتة المجدولة. تحمل اتصالات الوكلاء المقترنة سياستها الخاصة، تُضبط لكل اتصال في الإعدادات ← اتصالات الوكلاء
    .placeholder = allow

## assistant

config-assistant-auto-summarize = التلخيص التلقائي
    .hint = تلخيص المحادثات الطويلة وضغطها تلقائيًا لتوفير السياق
config-assistant-check-interval-seconds = فترة الفحص
    .hint = عدد مرات فحص المجدول للمهام التي يجب تشغيلها
    .unit = ثوانٍ
config-assistant-default-timeout-seconds = المهلة الافتراضية
    .hint = أقصى مدة يمكن أن تعمل فيها مهمة مجدولة قبل إيقافها
    .unit = ثوانٍ
config-assistant-enabled = تفعيل المساعد
    .hint = تفعيل واجهة محادثة المساعد للمحادثات التفاعلية
config-assistant-event-triggers-enabled = مشغّلات الأحداث
    .hint = السماح للمساعد بتنفيذ إجراءات بناءً على الأحداث (معطّل افتراضيًا للأمان)
config-assistant-max-concurrent = الحد الأقصى للمهام المتزامنة
    .hint = أقصى عدد من المهام المجدولة التي يمكن تشغيلها في الوقت نفسه
config-assistant-max-session-messages = الحد الأقصى لرسائل الجلسة
    .hint = أقصى عدد من الرسائل في كل جلسة محادثة قبل التلخيص التلقائي
    .unit = رسائل
config-assistant-scheduled-tasks-enabled = المهام المجدولة
    .hint = تفعيل مهام المساعد الآلية التي تعمل وفق جدول

## chains

config-chains-show-preview = سلاسل المعاينة
    .hint = اعرض السلاسل غير المتاحة للجميع بعد. يسري بعد إعادة التشغيل.
config-chains-solana = Solana
config-chains-solana-enabled = مُفعَّل
    .hint = شغِّل Solana في هذه العملية. يسري بعد إعادة التشغيل.

## copy_trading

config-copy-trading-default-slippage-pct = الانزلاق السعري الافتراضي
    .hint = الانزلاق السعري الافتراضي للنسخ التجريبي والحي مستقبلًا
    .unit = %
config-copy-trading-enabled = نسخ المحافظ
    .hint = تفعيل معالجة مهام النسخ
config-copy-trading-latency-kill-switch-enabled = مفتاح إيقاف زمن الاستجابة
    .hint = إيقاف مهمة النسخ مؤقتًا عندما يبقى تأخر الاكتشاف الأخير عن صفقة الهدف فوق الحد المضبوط
config-copy-trading-latency-window-size = نافذة عينات زمن الاستجابة
    .hint = عدد الملاحظات الأخيرة التي يستخدمها مفتاح إيقاف زمن الاستجابة
config-copy-trading-max-active-tasks = الحد الأقصى للمهام النشطة
    .hint = أقصى عدد من مهام النسخ المفعّلة في آنٍ واحد؛ تُحتسب المهام التجريبية والحية معًا لأن كلًّا منها يراقب محفظته
config-copy-trading-max-arrival-distance-ms = الحد الأقصى لتأخر الوصول
    .hint = إيقاف مؤقت عندما تتجاوز نافذة العينات الأخيرة متوسط التأخر هذا بين صفقة الهدف والاكتشاف
    .unit = ms
config-copy-trading-readiness-min-closed-rounds = جولات الجاهزية للتداول الحي
    .hint = الجولات التجريبية المغلقة التي تحتاجها المهمة قبل أن تنجح قائمة جاهزيتها للتداول الحي
config-copy-trading-require-filter-pass = اشتراط اجتياز المرشحات
    .hint = نسخ الرموز التي يقبلها مسار الترشيح فقط

## events

config-events-enabled = تفعيل نظام الأحداث
    .hint = تحذير: قد تولّد الأحداث أكثر من 5 GB يوميًا. فعّله فقط للتصحيح/التطوير.
config-events-record-api = تسجيل أحداث API
    .hint = تسجيل أحداث واجهات API الخارجية ({ -dexscreener } و{ -geckoterminal } و{ -jupiter } API وغيرها)
config-events-record-connectivity = تسجيل أحداث الاتصال
    .hint = تسجيل أحداث مراقبة الاتصال وسلامة نقاط الاتصال
config-events-record-filtering = تسجيل أحداث الترشيح
    .hint = تسجيل أحداث ترشيح الرموز (حساب اللقطات وتقييم الرموز)
config-events-record-ohlcv = تسجيل أحداث OHLCV
    .hint = تسجيل أحداث مراقبة OHLCV (الاكتشاف والجلب والفجوات وملء البيانات السابقة)
config-events-record-pool = تسجيل أحداث المجمعات
    .hint = تسجيل أحداث اكتشاف المجمعات وتحليلها وحساب الأسعار
config-events-record-position = تسجيل أحداث المراكز
    .hint = تسجيل أحداث إدارة المراكز (الفتح والإغلاق وتحديثات الأرباح والخسائر)
config-events-record-rpc = تسجيل أحداث RPC
    .hint = تسجيل أحداث عميل RPC (الطلبات والاستجابات والأخطاء)
config-events-record-security = تسجيل أحداث الأمان
    .hint = تسجيل أحداث الأمان وتقييم المخاطر
config-events-record-swap = تسجيل أحداث المبادلة
    .hint = تسجيل أحداث تنفيذ المبادلة ({ -jupiter } وتفاعلات DEX)
config-events-record-system = تسجيل أحداث النظام
    .hint = تسجيل أحداث دورة حياة النظام (التشغيل والإيقاف والأخطاء)
config-events-record-token = تسجيل أحداث الرموز
    .hint = تسجيل الأحداث المتعلقة بالرموز (القائمة السوداء والبيانات الوصفية والخانات العشرية)
config-events-record-trader = تسجيل أحداث المتداول
    .hint = تسجيل أحداث تنسيق المتداول (دورة الحياة واتخاذ القرار)
config-events-record-transaction = تسجيل أحداث المعاملات
    .hint = تسجيل أحداث معاملات البلوكتشين (الإرسال والاستلام والتأكيد)
config-events-record-wallet = تسجيل أحداث المحفظة
    .hint = تسجيل أحداث المحفظة (تغيّر الرصيد وإدارة ATA)

