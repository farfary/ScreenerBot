config-wallet-dashboard-metrics-alltime-interval-secs = Atualização das métricas do painel (todo o período)
    .hint = Segundos entre os pré-cálculos das métricas de todo o período do painel
    .unit = segundos
config-wallet-flow-cache-backfill-batch = Tamanho do lote do cache de fluxo
    .hint = Máximo de novas transações processadas por sincronização
    .unit = linhas
config-wallet-flow-cache-lookback-secs = Janela de análise do cache de fluxo
    .hint = Janela de análise de segurança ao retomar a sincronização (segundos)
    .unit = segundos
config-wallet-flow-cache-update-secs = Atualização do cache de fluxo
    .hint = Segundos entre as sincronizações do cache de fluxo de SOL a partir do banco de transações
    .unit = segundos
config-wallet-max-daily-flow-days = Máximo de dias do fluxo diário
    .hint = Máximo de dias de dados de fluxo diário retornados (limite rígido)
    .unit = dias
config-wallet-min-balance-sol = Saldo mínimo de SOL
    .hint = Saldo mínimo de SOL necessário para swaps (limite de segurança)
    .unit = SOL
config-wallet-snapshot-interval-secs = Intervalo dos snapshots
    .hint = Segundos entre os snapshots periódicos do saldo da carteira. É apenas uma garantia: qualquer atividade on-chain atualiza o saldo em segundos
    .unit = segundos
config-wallet-watch-enabled = Monitoramento ativado
    .hint = Interruptor geral do serviço de observação de carteiras. A carteira própria é sempre monitorada, independentemente desta configuração
config-wallet-watch-high-activity-interval-secs = Intervalo de monitoramento de alta atividade
    .hint = Mínimo de segundos entre verificações de transações bem-sucedidas depois que uma carteira de alta atividade sinaliza nova atividade
    .unit = segundos
config-wallet-watch-max-targets = Máximo de alvos monitorados
    .hint = Número máximo de endereços colados que podem ser monitorados ao mesmo tempo (proteção do orçamento de assinaturas + RPC)
    .unit = alvos
config-wallet-watch-poll-fallback-secs = Intervalo de consulta de fallback do monitoramento
    .hint = Segundos entre as consultas de assinaturas intensificadas enquanto a assinatura compartilhada não está conectada
    .unit = segundos
config-wallet-watch-poll-interval-secs = Intervalo de consulta do monitoramento
    .hint = Segundos entre as consultas-base de assinaturas por alvo, como rede de segurança contra uma queda silenciosa do WebSocket
    .unit = segundos
config-wallet-watch-retention-days = Retenção do monitoramento
    .hint = Dias para manter as linhas de transações decodificadas de uma carteira monitorada (que não é a sua) antes de serem removidas
    .unit = dias

config-webserver-auth-custom-title = Título de login personalizado
    .hint = Título personalizado exibido na página de login. Deixe vazio para usar o padrão.
config-webserver-auth-enabled = Ativar autenticação
    .hint = Exige senha para acessar o painel no modo headless. Defina a senha pela CLI ou pela API.
config-webserver-auth-session-timeout-secs = Tempo limite da sessão
    .hint = Quanto tempo até uma sessão expirar e exigir novo login. 0 = nunca expira.
config-webserver-auth-show-logo = Mostrar logo
    .hint = Exibe o logo do { -brand } na página de login.
config-webserver-auth-show-name = Mostrar nome do app
    .hint = Exibe '{ -brand }' na página de login.
config-webserver-auth-totp-enabled = Ativar 2FA (TOTP)
    .hint = Exige o código TOTP além da senha. Configure nas configurações do painel.
config-webserver-host = Host
    .hint = IP a vincular: 127.0.0.1 = somente localhost, 0.0.0.0 = todas as interfaces (VPS/remoto; exige autenticação). Requer reinicialização.
    .placeholder = 127.0.0.1
config-webserver-port = Porta
    .hint = Porta de acesso ao painel (somente no modo headless). Requer reinicialização para ter efeito.

